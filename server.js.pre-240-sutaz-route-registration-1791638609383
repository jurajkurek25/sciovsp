app.post('/api/stripe/checkout', rateLimit, async (req, res) => {
  const { email } = req.body;
  if (!email) return res.status(400).json({ error: 'Chýba email.' });
  try {
    let customerId;
    const { data: user } = await supabase.from('users').select('stripe_customer_id').eq('email', email).single();
    if (user?.stripe_customer_id) {
      customerId = user.stripe_customer_id;
    } else {
      const customer = await stripe.customers.create({ email });
      customerId = customer.id;
      await supabase.from('users').upsert({ email, stripe_customer_id: customerId });
    }
    const { refCode, refType, plan, marketingConsent } = req.body;
    if (marketingConsent !== undefined) {
      await supabase.from('users').update({ marketing_emails_opt_out: !marketingConsent }).eq('email', email);
    }
    const cleanCode = refCode ? String(refCode).toUpperCase().trim() : null;

    // Zisti či je partner ref kód
    let isPartnerRef = false;
    if (cleanCode && refType === 'partner') {
      const { data: partnerCheck } = await supabase.from('partners')
        .select('id').eq('ref_code', cleanCode).single();
      isPartnerRef = !!partnerCheck;
    }

    // Vyber správny price ID — zľava ak partner ref kód
    let activePriceId;
    if (plan === 'elite') {
      activePriceId = isPartnerRef ? ELITE_PRICE_ID_REF : ELITE_PRICE_ID;
    } else {
      activePriceId = isPartnerRef ? PRICE_ID_REF : PRICE_ID;
    }

    // Ak user referral kód (nie partner), ulož do referrals
    if (cleanCode && !isPartnerRef) {
      const { data: referrer } = await supabase.from('users')
        .select('email, is_premium').eq('ref_code', cleanCode).single();
      if (referrer?.is_premium && referrer.email !== email) {
        await supabase.from('referrals').upsert({
          referrer_email: referrer.email,
          referred_email: email,
          code: cleanCode,
          rewarded: false,
          created_at: new Date().toISOString()
        }, { onConflict: 'referred_email' });
      }
    }

    const session = await stripe.checkout.sessions.create({
      customer: customerId,
      payment_method_types: ['card'],
      line_items: [{ price: activePriceId, quantity: 1 }],
      mode: 'subscription',
      success_url: APP_URL + '/?premium=1' + (plan==='elite'?'&plan=elite':'') + '&session_id={CHECKOUT_SESSION_ID}',
      cancel_url: APP_URL + '/?cancelled=1',
      locale: 'sk',
      allow_promotion_codes: true,
      metadata: { partner_ref: isPartnerRef ? cleanCode : null }
    });
    res.json({ url: session.url });
  } catch(err) {
    console.error('Stripe checkout:', err.message);
    res.status(500).json({ error: 'Chyba vytvorenia platby.' });
  }
});

