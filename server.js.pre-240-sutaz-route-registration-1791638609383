          const pUrl = new URL(process.env.PARTNER_SERVER_URL + '/api/partner/webhook/credit');
          const pOpts = {
            hostname: pUrl.hostname, port: pUrl.port || 443,
            path: pUrl.pathname, method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Content-Length': Buffer.byteLength(partnerPayload),
              'x-webhook-key': process.env.PARTNER_WEBHOOK_KEY
            }
          };
          const pReq = require('https').request(pOpts, r => r.resume());
          pReq.on('error', e => console.error('Partner webhook error:', e.message));
          pReq.write(partnerPayload); pReq.end();
        }
        break;
      }
      case 'customer.subscription.deleted':
      case 'customer.subscription.paused': {
        const sub = event.data.object;
        const customer = await stripe.customers.retrieve(sub.customer);
        await supabase.from('users').update({
          is_premium: false,
          subscription_status: 'cancelled'
        }).eq('email', customer.email);
        console.log('❌ Premium zrušený:', customer.email);
        break;
      }
      case 'invoice.payment_failed': {
        const invoice = event.data.object;
        const customer = await stripe.customers.retrieve(invoice.customer);
        await supabase.from('users').update({
          subscription_status: 'past_due'
        }).eq('email', customer.email);
        break;
      }
    }
    res.json({ received: true });
  } catch(err) {
    console.error('Webhook spracovanie:', err.message);
    res.status(500).json({ error: err.message });
  }
});

