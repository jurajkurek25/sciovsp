    + 'document.getElementById("fqSubmit").style.display="none";'
    + 'var r=document.getElementById("fqResult");r.style.display="block";'
    + 'r.innerHTML=\'<div class="fq-pct">\'+pct+\'%</div><p>\'+verdict+\'</p>\'+ctaHtml;'
    + '};'
    + '})();</script>';
}

