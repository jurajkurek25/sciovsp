app.get('/kurzy', async (req, res) => {
  try {
    const lang = blogLang(req);
    const T = lang === 'cs' ? {
      pageTitle: 'Video kurzy — SP Tréner', description: 'Video kurzy na přípravu k přijímacím testům — lekce s videem, materiály ke stažení a kvízem po každé lekci.',
      heading: 'Video kurzy', sub: 'Teoretický doplněk k praktickým testům — video lekce, materiály ke stažení a kvíz v každé lekci.',
      empty: 'Zatím tu nejsou žádné kurzy.', breadcrumb: 'Kurzy',
      filterAll: 'Vše', searchPlaceholder: 'Hledat…', noResults: 'Nic jsme nenašli. Zkus jiné hledání nebo kategorii.'
    } : {
      pageTitle: 'Video kurzy — SP Tréner', description: 'Video kurzy na prípravu k prijímacím testom — lekcie s videom, materiálmi na stiahnutie a kvízom po každej lekcii.',
      heading: 'Video kurzy', sub: 'Teoretický doplnok k praktickým testom — video lekcie, materiály na stiahnutie a kvíz v každej lekcii.',
      empty: 'Zatiaľ tu nie sú žiadne kurzy.', breadcrumb: 'Kurzy',
      filterAll: 'Všetko', searchPlaceholder: 'Hľadať…', noResults: 'Nič sme nenašli. Skús iné hľadanie alebo kategóriu.'
    };
    const CATEGORY_ICONS = { 'Príprava na skúšku': '🎯', 'Příprava na zkoušku': '🎯', 'Prihláška': '✍️', 'Přihláška': '✍️', 'Osobný rozvoj': '🧠', 'Osobní rozvoj': '🧠' };
    const categoryLabel = (cat) => (CATEGORY_ICONS[cat] ? CATEGORY_ICONS[cat] + ' ' : '') + cat;
    const { data: courses } = await supabase.from('courses').select('slug,title,description,price_cents,cover_image_url,category').eq('published', true).order('created_at', { ascending: false });
    const list = courses || [];
    const catList = [];
    const catSeen = {};
    list.forEach(c => { if (c.category && !catSeen[c.category]) { catSeen[c.category] = true; catList.push(c.category); } });
    const filterBar = catList.length ? `
      <div class="filter-bar">
        <input type="text" class="filter-search" id="kurzySearch" placeholder="${escapeHtml(T.searchPlaceholder)}" oninput="kurzyFilter()">
        <div class="filter-pills" id="kurzyPills">
          <span class="filter-pill active" data-cat="" onclick="kurzySetCat(this)">${escapeHtml(T.filterAll)}</span>
          ${catList.map(cat => `<span class="filter-pill" data-cat="${escapeHtml(cat)}" onclick="kurzySetCat(this)">${escapeHtml(categoryLabel(cat))}</span>`).join('')}
        </div>
      </div>` : '';
    const filterScript = catList.length ? `
      <script>
      var kurzyActiveCat = '';
      function kurzySetCat(el){
        document.querySelectorAll('#kurzyPills .filter-pill').forEach(function(p){ p.classList.remove('active'); });
        el.classList.add('active');
        kurzyActiveCat = el.getAttribute('data-cat') || '';
        kurzyFilter();
      }
      function kurzyFilter(){
        var q = (document.getElementById('kurzySearch').value || '').trim().toLowerCase();
        var anyVisible = false;
        document.querySelectorAll('.course-card').forEach(function(card){
          var matchesCat = !kurzyActiveCat || card.getAttribute('data-cat') === kurzyActiveCat;
          var matchesSearch = !q || (card.getAttribute('data-search') || '').indexOf(q) !== -1;
          var visible = matchesCat && matchesSearch;
          card.style.display = visible ? '' : 'none';
          if (visible) anyVisible = true;
        });
        document.getElementById('kurzyEmpty').style.display = anyVisible ? 'none' : 'block';
      }
      </script>` : '';
    const grid = list.length
      ? `${KURZY_STYLE}${filterBar}<div class="course-grid">${list.map(c => courseCardHtml(c, lang)).join('')}</div><p class="filter-empty" id="kurzyEmpty">${escapeHtml(T.noResults)}</p>${filterScript}`
      : `${KURZY_STYLE}<div class="empty-state">${T.empty}</div>`;
    const body = `<main class="page">
      <nav class="breadcrumb"><a href="/${lang === 'cs' ? '?lang=cs' : ''}">SP Tréner</a><span>/</span><span>${T.breadcrumb}</span></nav>
      <h1 class="hero-title">${T.heading}</h1>
      <p class="hero-sub">${T.sub}</p>
      ${grid}
    </main>`;
    const jsonLd = {
      '@context': 'https://schema.org', '@type': 'ItemList',
      itemListElement: list.map((c, i) => ({ '@type': 'Course', position: i + 1, name: c.title, url: BASE_URL_BLOG + '/kurzy/' + c.slug }))
    };
    res.send(blogLayout({
      title: T.pageTitle,
      description: T.description,
      body, canonicalPath: '/kurzy', jsonLd: [jsonLd], lang
    }));
  } catch (e) {
    res.status(500).send('Chyba servera.');
  }
});

app.get('/api/courses/:slug/banner-click', async (req, res) => {
  try {
    const { data: course } = await supabase.from('courses').select('id, slug, instructor_id').eq('slug', req.params.slug).maybeSingle();
    if (!course || !course.instructor_id) return res.redirect('/kurzy/' + req.params.slug);
    const { data: instructor } = await supabase.from('instructors').select('id, banner_link_url').eq('id', course.instructor_id).maybeSingle();
    if (!instructor || !instructor.banner_link_url) return res.redirect('/kurzy/' + req.params.slug);
    supabase.from('instructor_banner_clicks').insert({ instructor_id: instructor.id, course_id: course.id }).then(() => {}).catch(() => {});
    res.redirect(instructor.banner_link_url);
  } catch (e) {
    res.redirect('/kurzy/' + req.params.slug);
  }
});

