  try {
    const { count } = await supabase.from('course_purchases').select('*', { count: 'exact', head: true }).eq('email', req.userEmail);
    res.json({ hasCourse: (count || 0) > 0 });
  } catch (e) {
    res.status(500).json({ error: 'Chyba servera.' });
