// ── POST /api/clans/sync-stats — sync po každom teste ─────────
// Volá sa automaticky z frontendu po finishTest()
app.post('/api/clans/sync-stats', rateLimit, async (req, res) => {
  const user = await verifySupabaseToken(req);
  if (!user) return res.status(401).json({ error: 'Nie si prihlásený.' });

  const { estimatedPercentile, mode } = req.body;
  if (estimatedPercentile === undefined) return res.status(400).json({ error: 'Chýbajú dáta.' });
  // Mirror Mode testy neovplyvňujú klanov štatistiky (len tréning)
  if (mode === 'mirror') return res.json({ synced: 0, skipped: 'mirror mode' });

  try {
    const { data: memberships } = await supabase
      .from('clan_members').select('clan_id').eq('user_id', user.id);
    const today = new Date().toISOString().split('T')[0];
    const yesterday = new Date(Date.now() - 86400000).toISOString().split('T')[0];

    // Ulož percentil + increment tests_count do users (pre denné emaily) —
    // beží pre KAŽDÉHO usera, nie len členov klanu.
    const { estimatedV, estimatedA } = req.body;
    if (estimatedV !== undefined || estimatedA !== undefined) {
      const updateData = {};
      if (estimatedV !== undefined) updateData.last_percentile_v = estimatedV;
      if (estimatedA !== undefined) updateData.last_percentile_a = estimatedA;
      await supabase.rpc('increment_tests_count', { user_email: user.email })
        .catch(() => {});
      await supabase.from('users').update(updateData).eq('email', user.email)
        .catch(() => {});
    }

    // Globálny (na klane nezávislý) tréningový streak — používa ho Elite
    // denný email so streakom + odpočtom, funguje aj pre usera bez klanu.
    try {
      const { data: curStreak } = await supabase.from('training_streaks')
        .select('streak_days, last_active_date, best_percentile')
        .eq('email', user.email).maybeSingle();
      let globalStreak = curStreak?.streak_days || 0;
      if (!curStreak || curStreak.last_active_date !== today) {
        globalStreak = curStreak?.last_active_date === yesterday ? globalStreak + 1 : 1;
      }
      await supabase.from('training_streaks').upsert({
        email: user.email,
        streak_days: globalStreak,
        last_active_date: today,
        best_percentile: Math.max(curStreak?.best_percentile || 0, estimatedPercentile),
        updated_at: new Date().toISOString()
      }, { onConflict: 'email' });
    } catch (e) {
      console.error('training_streaks sync:', e.message);
    }

    if (!memberships?.length) return res.json({ synced: 0 });

    for (const { clan_id } of memberships) {
      const { data: current } = await supabase.from('clan_stats')
        .select('best_percentile, streak_days, last_active_date')
        .eq('clan_id', clan_id).eq('user_id', user.id).single();
      // Streak: +1 ak aktívny včera, 1 ak dlhšia pauza, nezmenený ak už dnes aktívny
      let streak = current?.streak_days || 0;
      if (!current || current.last_active_date !== today) {
        streak = current?.last_active_date === yesterday ? streak + 1 : 1;
      }

      const upsertPayload = {
        clan_id,
        user_id: user.id,
        email: user.email,
        display_name: user.user_metadata?.full_name || user.email.split('@')[0],
        best_percentile: Math.max(current?.best_percentile || 0, estimatedPercentile),
        streak_days: streak,
        last_active_date: today,
        updated_at: new Date().toISOString()
      };
      if (req.body.topicStats) {
        upsertPayload.topic_stats = req.body.topicStats;
      }
      await supabase.from('clan_stats').upsert(upsertPayload, {
        onConflict: 'clan_id,user_id'
      });
    }

    res.json({ synced: memberships.length });
  } catch(err) {
    console.error('clan sync:', err.message);
    res.status(500).json({ error: err.message });
  }
});

