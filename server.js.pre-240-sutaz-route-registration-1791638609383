function buildGroupedPrompt(topicConfig, part, systemPrompt, diff, diffMapArg) {
  const { topic, count, grouped, groupSize } = topicConfig;
  const activeDiffMap = diffMapArg || DIFFICULTY_MAP;

  const specialNotes = buildSpecialNotes(topic, count, grouped, groupSize);

  const userMsg = `Vygeneruj PRESNE ${count} SCIO VSP úloh pre okruh "${topic}" — ${part === 'verbal' ? 'verbálna' : 'analytická'} časť.

KRITICKÉ: Pole "questions" MUSÍ mať PRESNE ${count} prvkov — nie ${count-1}, nie ${count+1}, PRESNE ${count}.
Pred odoslaním spočítaj prvky: ak ich nie je ${count}, doplň alebo odsekni.

OBTIAŽNOSŤ: ${activeDiffMap[diff] || activeDiffMap.medium}

${specialNotes}

ZÁVÄZNÝ JSON FORMÁT (žiadny iný text, žiadne backticks):
{
  "topic": "${topic}",
  "part": "${part}",
  "questions": [
  {
    "topic": "${topic}",
    "text": "text úlohy",
    "context": null,
    "options": ["možnosť A", "možnosť B", "možnosť C", "možnosť D"],
    "answer": 0,
    "antonym_answer": null,
    "explanation": "stručné vysvetlenie (1-2 vety po slovensky)"
  }
  ]
}
KONTROLA: questions.length === ${count} — inak je odpoveď neplatná.`;

  return { system: systemPrompt, user: userMsg };
  }

function buildSpecialNotes(topic, count, grouped, groupSize) {
  const notes = {
    'Antosynonymá': `ŠPECIÁLNE: "options" = pole 8 prvkov (index 0-3 = synonymum, 4-7 = antonymum). Pridaj pole "antonym_answer" (index 4-7 správneho antonyma). Veta musí dávať kontext pre podčiarknuté slovo.`,

    'Porozumenie textu': `ŠPECIÁLNE: Vytvor ${count/groupSize} RÔZNYCH pasáží (každá 200-350 slov, 3-5 odsekov, fakticky správna, slovenský kontext). K každej pasáži PRESNE 3 otázky. Všetky otázky zdieľajúce rovnakú pasáž musia mať identické pole "context" s celým textom pasáže. Typy otázok pre každú skupinu kombinuj: (1) čo vyplýva / čo je v rozpore, (2) čo je iba domnienka / ako autor hodnotí, (3) čo opisuje časť textu / najlepší nadpis.`,

    'Srovnávacie čítanie': `ŠPECIÁLNE: Vytvor JEDEN pár textov (každý 150-250 slov, na rovnakú tému z odlišných perspektív). Pole "context" = "Text 1:\\n[text]\\n\\nText 2:\\n[text]". K tomuto páru PRESNE 4 otázky, všetky zdieľajú rovnaký context. Typy otázok: (1) vzťah medzi textami, (2) postoj každého autora, (3) na čom by sa zhodli/líšili, (4) čo vyplýva z oboch.`,

    'Grafy a tabuľky': `ŠPECIÁLNE: Vytvor ${count/groupSize} RÔZNYCH scenárov (každý s konkrétnou tabuľkou alebo popisom grafu s číslami). K každému scenáru PRESNE 3 otázky. Pole "context" = kompletný popis tabuľky/grafu ASCII alebo textom. VŠETKY čísla v scenári musia byť navzájom konzistentné. OVER výpočty pre každú otázku.`,

    'Zebry (logické úlohy)': `ŠPECIÁLNE: Vytvor 1–2 scenáre (4-6 osôb/objektov + 3-5 podmienok). K každému scenáru 3-4 otázky zdieľajúce rovnaký "context". Pole "context" = úplný popis scenára a podmienok. Otázky: (1) pri ktorom tvrdení možno jednoznačne určiť X, (2) ktoré tvrdenie je v rozpore, (3) kto MOHOL, (4) pri kom je možné jednoznačne určiť. OVER logiku celého scenára pred odoslaním.`,

    'Porovnávanie hodnôt': `ŠPECIÁLNE: "options" VŽDY presne: ["Hodnota vľavo je väčšia než hodnota vpravo.", "Hodnota vpravo je väčšia než hodnota vľavo.", "Hodnota vpravo je rovnaká ako hodnota vľavo.", "Nie je možné jednoznačne určiť, ktorá hodnota je väčšia."]. "text" = podmienka nad tabuľkou (ak existuje) + "\\nVľavo: [výraz] | Vpravo: [výraz]". Správne odpovede: A≈25%, B≈25%, C≈25%, D≈25%. OVER výpočet.`,

    'Postačujúce podmienky': `ŠPECIÁLNE: "options" VŽDY presne: ["Každé tvrdenie je samo osebe dostačujúce.", "Práve jedno z tvrdení je samo osebe dostačujúce.", "Obe tvrdenia dohromady sú dostačujúce, ale ani jedno z tvrdení nie je samo osebe dostačujúce.", "Ani obe tvrdenia dohromady nie sú dostačujúce."]. "text" = otázka + "\\n(1) [tvrdenie]\\n(2) [tvrdenie]". OVER logiku oboch smerov pred odoslaním.`,
  };

  return notes[topic] || `Vygeneruj ${count} autentických SCIO úloh pre okruh "${topic}". Každá úloha musí byť unikátna. Odpovede rovnomerne: A≈25%, B≈25%, C≈25%, D≈25%.`;
  }

function callAnthropic(system, userMessage) {
  return callClaudeWithFallback((model) => new Promise((resolve) => {
    const payload = JSON.stringify({
      model,
      max_tokens: 8096,
      system,
      messages: [{ role: 'user', content: userMessage }]
    });
    const options = {
      hostname: 'api.anthropic.com',
      path: '/v1/messages',
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Content-Length': Buffer.byteLength(payload),
        'x-api-key': API_KEY,
        'anthropic-version': '2023-06-01'
      }
    };
    const apiReq = https.request(options, (apiRes) => {
      let data = '';
      apiRes.on('data', chunk => data += chunk);
      apiRes.on('end', () => resolve({ ok: apiRes.statusCode >= 200 && apiRes.statusCode < 300, statusCode: apiRes.statusCode, data }));
    });
    apiReq.on('error', (err) => resolve({ ok: false, statusCode: 502, data: JSON.stringify({ error: { message: err.message } }) }));
    apiReq.write(payload);
    apiReq.end();
  })).then((result) => {
    let parsed;
    try { parsed = JSON.parse(result.data); } catch (e) { throw new Error('Neplatný JSON: ' + e.message); }
    if (parsed.error) throw new Error(parsed.error.message);
    const text = parsed.content?.find(b => b.type === "text")?.text || '';
    const clean = text.replace(/```json\s*/gi,'').replace(/```\s*/gi,'').trim();
    try {
      return JSON.parse(clean.replace(/,\s*([}\]])/g,'$1'));
    } catch (e) { throw new Error('Neplatný JSON: ' + e.message); }
  });
}

app.post('/api/generate-full-test', rateLimit, async (req, res) => {
  if (!API_KEY) return res.status(500).json({ error: 'Server nie je nakonfigurovaný.' });
  const { difficulty = 'medium', lang = 'sk' } = req.body;
  const isCZ = lang === 'cz';

  try {
    console.log('Generujem celý AI test, obtiažnosť:', difficulty);

    const verbalTopics   = isCZ ? VERBAL_TOPICS_FULL_CZ   : VERBAL_TOPICS_FULL;
    const analyticalTopics = isCZ ? ANALYTICAL_TOPICS_FULL_CZ : ANALYTICAL_TOPICS_FULL;
    const vSystem      = isCZ ? VERBAL_SYSTEM_CZ   : VERBAL_SYSTEM;
    const aSystem      = isCZ ? ANALYTICAL_SYSTEM_CZ : ANALYTICAL_SYSTEM;
    const diffMapFull  = isCZ ? DIFFICULTY_MAP_CZ   : DIFFICULTY_MAP;

    // ── Generovanie jedného okruhu s retry ────────────────────
    // Pokus 1: paralelne so všetkými okruhmi.
    // Ak AI vráti menej úloh ako expected → retry s doplňujúcim promptom.
    // Max 2 retrys per okruh. Prebytok sa orezáva (slice).
    async function generateTopicWithRetry(topicConfig, part, systemPrompt, diff) {
      const { topic, count } = topicConfig;
      const MAX_RETRIES = 2;
      let collected = [];

      for (let attempt = 0; attempt <= MAX_RETRIES; attempt++) {
        const missing = count - collected.length;
        if (missing <= 0) break;

        // Na retryoch zmenšíme počet — pýtame len chýbajúce
        const attemptConfig = attempt === 0
          ? topicConfig
          : { ...topicConfig, count: missing };

        // Na retryoch pridáme do promptu kontextovú poznámku
        const retryNote = attempt === 0 ? '' :
          `
DOPLNOK (pokus ${attempt + 1}): Predchádzajúci pokus vrátil menej úloh. Vygeneruj PRESNE ${missing} nových úloh pre tento okruh. Musia byť odlišné od typických príkladov.`;

        const p = buildGroupedPrompt(attemptConfig, part, systemPrompt, diff, diffMapFull);
        p.user += retryNote;

        try {
          const result = await callAnthropic(p.system, p.user);
          const newQs = result.questions || [];
          collected = collected.concat(newQs);
          console.log(`[${part}] ${topic} pokus ${attempt + 1}: ${newQs.length} úloh (celkom ${collected.length}/${count})`);
          if (collected.length >= count) break;
        } catch(err) {
          console.error(`[${part}] ${topic} pokus ${attempt + 1} zlyhalo:`, err.message);
          if (attempt === MAX_RETRIES && collected.length === 0) {
            return { questions: [] };
          }
        }
      }

      // Orezaj na presný počet
      return { questions: collected.slice(0, count) };
    }

    // Spusti všetky okruhy paralelne (každý má vlastný retry mechanizmus)
    const verbalPromises = verbalTopics.map(cfg =>
      generateTopicWithRetry(cfg, 'verbal', vSystem, difficulty)
    );
    const analyticalPromises = analyticalTopics.map(cfg =>
      generateTopicWithRetry(cfg, 'analytical', aSystem, difficulty)
    );

    const [verbalResults, analyticalResults] = await Promise.all([
      Promise.all(verbalPromises),
      Promise.all(analyticalPromises)
    ]);

    const timestamp = Date.now();

    // Zbieraj otázky + orezaj na presný počet per okruh
    const assembleQs = (results, topics, part, tsPrefix) => {
      const dateStr = new Date().toLocaleDateString('sk-SK');
      const all = [];
      results.forEach((r, i) => {
        const cfg = topics[i];
        const expected = cfg.count;
        const qs = (r.questions || []).slice(0, expected); // orezaj prebytok
        qs.forEach((q, j) => all.push({
          ...q,
          id: `${tsPrefix}_${i}_${j}`,
          part,
          isAI: true,
          generatedAt: dateStr
        }));
        if (qs.length !== expected) {
          console.warn(`[${part}] ${cfg.topic}: očakávaných ${expected}, dostali ${r.questions?.length ?? 0}, použité ${qs.length}`);
        }
      });
      return all;
    };

    const verbalQs     = assembleQs(verbalResults,     verbalTopics,     'verbal',     `ai_full_v_${timestamp}`);
    const analyticalQs = assembleQs(analyticalResults, analyticalTopics, 'analytical', `ai_full_a_${timestamp}`);

    const expectedV = verbalTopics.reduce((s, t) => s + t.count, 0);   // 33
    const expectedA = analyticalTopics.reduce((s, t) => s + t.count, 0); // 33

    console.log(`Vygenerovaných: ${verbalQs.length}/${expectedV}V + ${analyticalQs.length}/${expectedA}A = ${verbalQs.length + analyticalQs.length}/66 celkom`);

    if (verbalQs.length === 0 || analyticalQs.length === 0) {
      return res.status(500).json({ error: 'AI nevygenerovala dostatok úloh.' });
    }

    // Upozornenie ak je výrazná odchýlka (> 3 úlohy od cieľa)
    if (Math.abs(verbalQs.length - expectedV) > 3 || Math.abs(analyticalQs.length - expectedA) > 3) {
      console.warn(`⚠️ Počet úloh sa výrazne líši od cieľa 33+33. Verbal: ${verbalQs.length}, Analytical: ${analyticalQs.length}`);
    }

    const allQuestions = [...verbalQs, ...analyticalQs];

    res.json({
      success: true,
      verbal: verbalQs.length,
      analytical: analyticalQs.length,
      total: allQuestions.length,
      questions: allQuestions
    });

  } catch(err) {
    console.error('Chyba generovania celého testu:', err.message);
    res.status(500).json({ error: err.message || 'Chyba generovania.' });
  }
});

