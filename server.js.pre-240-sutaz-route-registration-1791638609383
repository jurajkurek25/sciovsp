function getWeekStart() {
  const d = new Date();
  const day = d.getDay(); // 0=nedeľa
  const diff = d.getDate() - day + (day === 0 ? -6 : 1); // pondelok
  return new Date(d.setDate(diff)).toISOString().split('T')[0];
}

