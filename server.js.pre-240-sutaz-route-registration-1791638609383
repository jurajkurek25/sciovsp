app.post('/api/referral/my-code', async (req, res) => {
  const user = await verifySupabaseToken(req);
  if (!user) return res.status(401).json({ error: 'Nie si prihlásený.' });

  try {
    const { data: dbUser } = await supabase
      .from('users')
      .select('ref_code, is_premium, premium_expires_at')
      .eq('email', user.email)
      .single();

    if (!dbUser?.is_premium) return res.status(403).json({ error: 'Len Premium môže zdieľať kód.' });

    // Vráť existujúci alebo vygeneruj nový
    let code = dbUser.ref_code;
    if (!code) {
      code = generateRefCode(user.email);
      // Zaisti unikátnosť
      let attempts = 0;
      while (attempts < 5) {
        const { data: existing } = await supabase.from('users').select('email').eq('ref_code', code).single();
        if (!existing) break;
        code = generateRefCode(user.email);
        attempts++;
      }
      await supabase.from('users').update({ ref_code: code }).eq('email', user.email);
    }

    // Počet úspešných odporúčaní
    const { count } = await supabase
      .from('referrals')
      .select('*', { count: 'exact', head: true })
      .eq('referrer_email', user.email)
      .eq('rewarded', true);

    // Bonus dni zostatok
