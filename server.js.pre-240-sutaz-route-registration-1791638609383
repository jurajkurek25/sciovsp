function buildSpecialNotesForTopic(topic, count) {
  const notes = {
    'Antosynonymá': `options = 8 prvkov [A,B,C,D=synonymá, E,F,G,H=antonymá], pridaj "antonym_answer" (index 4-7).`,
    'Porozumenie textu': `Vytvor pasáž (200-350 slov) v poli "context". ${count} otázok zdieľa rovnaký context.`,
    'Srovnávacie čítanie': `"context" = "Text 1:\\n[text]\\n\\nText 2:\\n[text]". ${count} otázok zdieľa context.`,
    'Grafy a tabuľky': `Tabuľka/graf v poli "context". ${count} otázok zdieľa context. OVER výpočty.`,
    'Zebry (logické úlohy)': `Scenár + podmienky v poli "context". ${count} otázok zdieľa context. OVER logiku.`,
    'Porovnávanie hodnôt': `options vždy: ["Hodnota vľavo je väčšia než hodnota vpravo.","Hodnota vpravo je väčšia než hodnota vľavo.","Hodnota vpravo je rovnaká ako hodnota vľavo.","Nie je možné jednoznačne určiť, ktorá hodnota je väčšia."]. OVER výpočet.`,
    'Postačujúce podmienky': `options vždy: ["Každé tvrdenie je samo osebe dostačujúce.","Práve jedno z tvrdení je samo osebe dostačujúce.","Obe tvrdenia dohromady sú dostačujúce, ale ani jedno z tvrdení nie je samo osebe dostačujúce.","Ani obe tvrdenia dohromady nie sú dostačujúce."]. OVER logiku.`,
  };
  return notes[topic] || `Každá úloha unikátna. Odpovede rovnomerne: A≈25%, B≈25%, C≈25%, D≈25%.`;
}


