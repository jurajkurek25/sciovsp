function buildGroupedPromptMirror(topicConfig, part, systemPrompt) {
  const { topic, count } = topicConfig;
  return {
    system: systemPrompt,
    user: `Vygeneruj PRESNE ${count} SCIO VSP úloh pre okruh "${topic}" — ${part === 'verbal' ? 'verbálna' : 'analytická'} časť.
OBTIAŽNOSŤ: Ťažké — úlohy ktoré bežne robia chyby. Žiadne ľahké zadania.
KRITICKÉ: Pole "questions" musí mať PRESNE ${count} prvkov.
ZÁVÄZNÝ JSON: {"topic":"${topic}","part":"${part}","questions":[{"topic":"${topic}","text":"...","context":null,"options":["A","B","C","D"],"answer":0,"antonym_answer":null,"explanation":"..."}]}`
  };
}

// Helper callAnthropicSimple pre nové endpointy
app.post('/api/generate-mirror', rateLimit, requireElite, async (req, res) => {
  if (!API_KEY) return res.status(500).json({ error: 'Server nie je nakonfigurovaný.' });
  const { topics, lang = 'sk' } = req.body;
  if (!topics?.length) return res.status(400).json({ error: 'Chýbajú okruhy.' });

  const isCZ = lang === 'cz';
  const vSystem = isCZ ? VERBAL_SYSTEM_CZ : VERBAL_SYSTEM;
  const aSystem = isCZ ? ANALYTICAL_SYSTEM_CZ : ANALYTICAL_SYSTEM;

  const VERBAL_TOPICS_ALL = isCZ ? VERBAL_TOPICS_FULL_CZ : VERBAL_TOPICS_FULL;
  const ANALYTICAL_TOPICS_ALL = isCZ ? ANALYTICAL_TOPICS_FULL_CZ : ANALYTICAL_TOPICS_FULL;

  // Filtruj len slabé okruhy, priraď systém prompt
  const toGenerate = topics.slice(0, 6).map(topic => {
    const vCfg = VERBAL_TOPICS_ALL.find(t => t.topic === topic);
    const aCfg = ANALYTICAL_TOPICS_ALL.find(t => t.topic === topic);
    const cfg = vCfg || aCfg;
    const part = vCfg ? 'verbal' : 'analytical';
    const system = vCfg ? vSystem : aSystem;
    if (!cfg) return null;
    // Mirror Mode: zvýšená obtiažnosť
    return { cfg: { ...cfg, count: Math.min(cfg.count, 5) }, part, system };
  }).filter(Boolean);

  if (!toGenerate.length) return res.status(400).json({ error: 'Žiadne platné okruhy.' });

  try {
    const results = await Promise.all(toGenerate.map(({ cfg, part, system }) => {
      const p = buildGroupedPromptMirror(cfg, part, system);
      return callAnthropicSimple(p.system, p.user).catch(() => ({ questions: [] }));
    }));

    const timestamp = Date.now();
    const questions = results.flatMap((r, i) => {
      const { part } = toGenerate[i];
      return (r.questions || []).slice(0, toGenerate[i].cfg.count).map((q, j) => ({
        ...q, id: `mirror_${timestamp}_${i}_${j}`, part, isAI: true, isMirror: true,
        generatedAt: new Date().toLocaleDateString('sk-SK')
      }));
    });

    res.json({ success: true, questions, topicsUsed: topics });
  } catch(err) {
    res.status(500).json({ error: err.message });
  }
});

// Helper pre Mirror Mode — jednoduchší prompt (vyššia obtiažnosť)
function callAnthropicSimple(system, userMessage) {
  return callClaudeWithFallback((model) => new Promise((resolve) => {
    const payload = JSON.stringify({
      model, max_tokens: 4096, system,
      messages: [{ role: 'user', content: userMessage }]
    });
    const https = require('https');
    const req = https.request({
      hostname: 'api.anthropic.com', path: '/v1/messages', method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(payload), 'x-api-key': API_KEY, 'anthropic-version': '2023-06-01' }
    }, (apiRes) => {
      let data = '';
      apiRes.on('data', chunk => data += chunk);
      apiRes.on('end', () => resolve({ ok: apiRes.statusCode >= 200 && apiRes.statusCode < 300, statusCode: apiRes.statusCode, data }));
    });
    req.on('error', (err) => resolve({ ok: false, statusCode: 502, data: JSON.stringify({ error: { message: err.message } }) }));
    req.write(payload); req.end();
  })).then((result) => {
    const parsed = JSON.parse(result.data);
    if (parsed.error) throw new Error(parsed.error.message);
    const text = parsed.content?.find(b => b.type === "text")?.text || '';
    const clean = text.replace(/```json\s*/gi,'').replace(/```\s*/gi,'').trim();
    return JSON.parse(clean.replace(/,\s*([}\]])/g,'$1'));
  });
}

