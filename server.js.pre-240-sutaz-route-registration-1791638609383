        console.log('✅ Premium aktivovaný:', email);

        // Odošli kredit partnerovi ak platba prišla cez partner ref kód
        const partnerRef = session.metadata?.partner_ref || null;
        if (partnerRef && process.env.PARTNER_SERVER_URL && process.env.PARTNER_WEBHOOK_KEY) {
