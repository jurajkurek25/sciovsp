# ============================================
# SP Tréner Ads — samostatná appka (ad.sptrener.online)
# Skopíruj do .env a vyplň. NIKDY necommituj .env so skutočnými
# hodnotami — je v .gitignore, nechaj ho tam.
# ============================================

# Server
PORT=3849
APP_URL=https://ad.sptrener.online

# Odkiaľ smie hlavná appka volať verejné endpointy (serve/impression) cez CORS
MAIN_APP_ORIGIN=https://sptrener.online

# Vlastné prihlásenie inzerentov (žiadny Supabase/magic-link) — JWT podpis.
# Vygeneruj náhodný reťazec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# MySQL — lokálna databáza "reklama"
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=reklama
MYSQL_USER=reklama
MYSQL_PASSWORD=

# Stripe — môže byť rovnaký účet ako hlavná appka, len iné price ID
STRIPE_SECRET_KEY=sk_live_...
STRIPE_AD_PRICE_ID=price_...        # 49€/mesiac za banner
STRIPE_VIDEO_AD_PRICE_ID=price_...  # 149€/mesiac za video reklamu

# Automatická AI kontrola reklamného obsahu (moderation.js) — POVINNÉ.
# Bez tohto kľúča appka VŠETKY uploady zamietne (fail-closed politika).
# Môže byť rovnaký kľúč ako v hlavnej appke.
ANTHROPIC_API_KEY=sk-ant-...

# Voliteľné: email adminovi pri každom AI zamietnutí (audit/dohľad).
# Bez SMTP appka aj tak moderuje správne, len sa neposiela notifikácia
# (zamietnutia vidno v tabuľke moderation_log a v pm2 logoch).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
