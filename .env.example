# ============================================
# VSP Tréner — Environment Variables
# Skopíruj do .env a vyplň hodnoty
# ============================================

# Server
PORT=3000
NODE_ENV=production

# JWT — vygeneruj: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ZMENA_TOTO_NA_DLHY_NAHODNY_STRING_64_ZNAKOV

# PostgreSQL — uprav podľa tvojho VPS
DATABASE_URL=postgresql://postgres:heslo@localhost:5432/vsp_trainer

# Stripe — nájdeš na dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...          # ID mesačného plánu z Stripe (SP Tréner Premium)
STRIPE_AD_PRICE_ID=price_...       # ID mesačného plánu z Stripe (banner — 49€/mesiac)
STRIPE_VIDEO_AD_PRICE_ID=price_... # ID mesačného plánu z Stripe (rewarded video — 149€/mesiac)

# Anthropic Claude API — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Email (napr. Gmail App Password alebo Resend.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tvoj@email.com
SMTP_PASS=app_password_tu
SMTP_FROM=VSP Tréner <tvoj@email.com>

# Frontend URL (pre CORS a emaily)
FRONTEND_URL=https://tvoja-domena.sk

# Reklamný subdomain (SP Tréner Ads) — musí smerovať na ten istý server (DNS CNAME/A na rovnaký host)
AD_FRONTEND_URL=https://ad.sptrener.online

# Supabase — používa sa na overenie prihlásených používateľov v /api/rewards/*
# (app.html sa prihlasuje cez Supabase, nie cez JWT_SECRET vyššie). Anon key nie je
# tajný — je to ten istý kľúč, čo je natvrdo v public/app.html. Voliteľné, defaultuje
# na hodnoty z app.html, over si ich v Supabase dashboard → Settings → API ak meníš projekt.
SUPABASE_URL=https://zrnqiwareacqyndwchsv.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpybnFpd2FyZWFjcXluZHdjaHN2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQyMDA3NTAsImV4cCI6MjA4OTc3Njc1MH0.iUne23YDxp12Iwxdk9U8MfcV0NTBtrNf9OgsjQdiADk
