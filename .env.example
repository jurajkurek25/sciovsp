# ============================================
# SP Tréner — Environment Variables
# Skopíruj do .env a vyplň hodnoty. NIKDY necommituj .env so skutočnými
# hodnotami — je v .gitignore, nechaj ho tam.
# ============================================

# Server
PORT=3848
DOMAIN=sptrener.online
APP_URL=https://sptrener.online/
ALLOWED_ORIGIN=https://sptrener.online

# Supabase — dashboard.supabase.com → tvoj projekt → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# Stripe — dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_P85_PRICE_ID=price_...
STRIPE_PRICE_ID_REF=price_...
STRIPE_ELITE_PRICE_ID=price_...
STRIPE_ELITE_PRICE_ID_REF=price_...

# SP Tréner Ads — nové: banner (49€/mesiac) a video (149€/mesiac), pozri deploy-patch/
STRIPE_AD_PRICE_ID=price_...
STRIPE_VIDEO_AD_PRICE_ID=price_...
AD_APP_URL=https://ad.sptrener.online

# Anthropic Claude API — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Interné API pre appku ad.sptrener.online (samostatný server/DB) — umožňuje
# jej automaticky publikovať PR články na tento blog po zaplatení. Vygeneruj:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rovnaká hodnota musí byť aj v .env appky ad.sptrener.online (INTERNAL_API_SECRET).
INTERNAL_API_SECRET=

# Obchod (routes/shop.js) — čiarkou oddelený zoznam emailov s prístupom do
# /obchod/admin. Bez tohto padne fallback na ADMIN_EMAIL.
SHOP_ADMIN_EMAILS=

# Lulu Print API (fyzické publikácie/tlačené knihy, routes/shop.js + lulu.js)
# — vytvor účet na developers.lulu.com (produkcia) a developers.sandbox.lulu.com
# (sandbox, SAMOSTATNÝ účet) a vygeneruj Client Key/Secret na
# developers.(sandbox.)lulu.com/user-profile/api-keys.
# LULU_ENV musí byť "sandbox", kým celý flow neoveríš end-to-end -- na
# "production" prepni AŽ keď máš na produkčnom Lulu účte nastavenú platebnú
# kartu (Settings → Payment Methods), inak Print-Joby ostanú navždy UNPAID.
LULU_ENV=sandbox
LULU_SANDBOX_CLIENT_KEY=
LULU_SANDBOX_CLIENT_SECRET=
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
# Kontaktný email, ktorý Lulu použije, ak vznikne otázka k Print-Jobu
# (voliteľné -- inak sa použije ADMIN_EMAIL).
SHOP_CONTACT_EMAIL=
