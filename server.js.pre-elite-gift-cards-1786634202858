app.post('/api/clans/create', rateLimit, async (req, res) => {
  const user = await verifySupabaseToken(req);
  if (!user) return res.status(401).json({ error: 'Nie si prihlásený.' });

  const { name, displayName } = req.body;
  if (!name || name.trim().length < 2 || name.trim().length > 30)
    return res.status(400).json({ error: 'Názov klanu musí mať 2–30 znakov.' });

  // Server-side Premium overenie
  try {
    const { data: userRec } = await supabase.from('users').select('is_premium').eq('email', user.email).single();
    if (!userRec?.is_premium) {
      return res.status(403).json({ error: 'Vytváranie klanov je len pre Premium používateľov.' });
    }
  } catch(e) { /* ak tabuľka neexistuje, pokračuj */ }

  try {
    // Generuj unikátny kód (max 5 pokusov)
    let code, attempts = 0;
    while (attempts < 5) {
      code = generateClanCode();
      const { data: existing } = await supabase.from('clans').select('id').eq('code', code).single();
      if (!existing) break;
      attempts++;
    }

    // Vytvor klan
    const { data: clan, error: clanErr } = await supabase
      .from('clans')
      .insert({ name: name.trim(), code, owner_id: user.id })
      .select().single();
    if (clanErr) throw clanErr;

    // Pridaj zakladateľa ako člena
    await supabase.from('clan_members').insert({
      clan_id: clan.id, user_id: user.id,
      email: user.email,
      display_name: displayName || user.email.split('@')[0]
    });

    // Inicializuj štatistiky
    await supabase.from('clan_stats').insert({
      clan_id: clan.id, user_id: user.id,
      email: user.email,
      display_name: displayName || user.email.split('@')[0],
      week_start: new Date().toISOString().split('T')[0]
    });

    res.json({ success: true, clan });
  } catch(err) {
    console.error('clan create:', err.message);
    res.status(500).json({ error: err.message });
  }
});

