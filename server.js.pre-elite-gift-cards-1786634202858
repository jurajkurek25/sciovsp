            rewarded_at: new Date().toISOString()
          }).eq('id', pendingRef.id);

          console.log('✅ Referral spracovaný:', pendingRef.referrer_email, '->', email);
        }

        console.log('✅ Premium aktivovaný:', email);

        // Odošli kredit partnerovi ak platba prišla cez partner ref kód
        const partnerRef = session.metadata?.partner_ref || null;
        if (partnerRef && process.env.PARTNER_SERVER_URL && process.env.PARTNER_WEBHOOK_KEY) {
          const partnerPayload = JSON.stringify({
            refCode: partnerRef,
            customerEmail: email,
            customerName: email.split('@')[0],
            plan: sessionPlan,
            amountPaid: (session.amount_total || 0) / 100
          });
