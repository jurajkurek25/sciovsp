// ── Generátor referral kódu ───────────────────────────────────
function generateRefCode(email) {
  const base = email.split('@')[0].toUpperCase().replace(/[^A-Z]/g, '').substring(0, 5).padEnd(5, 'X');
  const num = String(Math.floor(Math.random() * 900) + 100);
  return base + num;
}

// ── Pomocná: pridaj N dní k Premium userovi ───────────────────
async function addPremiumDays(email, days) {
  const { data: user } = await supabase
    .from('users')
    .select('is_premium, premium_expires_at, subscription_status')
    .eq('email', email)
    .single();
  if (!user) return;

  const now = new Date();
  let base;
  if (user.premium_expires_at && new Date(user.premium_expires_at) > now) {
    // Má aktívny bonus — predĺži od konca
    base = new Date(user.premium_expires_at);
  } else if (user.is_premium && user.subscription_status === 'active') {
    // Má aktívne predplatné — bonus začína od dnes
    base = now;
  } else {
    // Nemá Premium — nedávame bonus (neplatí za predplatné)
    return;
  }

  const newExpiry = new Date(base.getTime() + days * 24 * 60 * 60 * 1000);
  await supabase.from('users').update({
    premium_expires_at: newExpiry.toISOString()
  }).eq('email', email);

  console.log(`+${days} dní Premiumu → ${email} (do ${newExpiry.toLocaleDateString('sk-SK')})`);
}

