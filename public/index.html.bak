let currentLang='sk';

function detectInitialLanguage(){
  const saved=localStorage.getItem('vsp-lang');
  if(saved==='sk'||saved==='cs')return saved;
  return (navigator.language||'').toLowerCase().startsWith('cs')?'cs':'sk';
}

function setLanguage(lang){
  currentLang=lang==='cs'?'cs':'sk';
  localStorage.setItem('vsp-lang',currentLang);
  applyLanguage(currentLang);
}

function applyLanguage(lang){
  const t=translations[lang];if(!t)return;
  document.documentElement.lang=lang;
  document.title=t.pageTitle;
  document.getElementById('langSkBtn').classList.toggle('active',lang==='sk');
  document.getElementById('langCsBtn').classList.toggle('active',lang==='cs');
  const sH=(id,v)=>{const e=document.getElementById(id);if(e)e.innerHTML=v;};
  const sT=(id,v)=>{const e=document.getElementById(id);if(e)e.textContent=v;};
  const qH=(sel,v,i=0)=>{const els=document.querySelectorAll(sel);if(els[i])els[i].innerHTML=v;};
  const qT=(sel,v,i=0)=>{const els=document.querySelectorAll(sel);if(els[i])els[i].textContent=v;};
  // Nav
  qT('.nav-cta',t.navCta);
  // Hero
  sT('heroEyebrow',t.heroEyebrow);
  sH('heroHeadline',t.heroHeadline);
  sT('heroSub',t.heroSub);
  sT('heroBtn1',t.heroBtn1);
  sT('heroBtn2',t.heroBtn2);
  sT('heroStat1',t.heroStat1);sT('heroStat2',t.heroStat2);sT('heroStat3',t.heroStat3);sT('heroStat4',t.heroStat4);
  // Problem
  sT('problemLabel',t.problemLabel);sH('problemTitle',t.problemTitle);
  sT('pain1Title',t.pain1Title);sT('pain1Desc',t.pain1Desc);
  sT('pain2Title',t.pain2Title);sT('pain2Desc',t.pain2Desc);
  sT('pain3Title',t.pain3Title);sT('pain3Desc',t.pain3Desc);
  sT('pain4Title',t.pain4Title);sT('pain4Desc',t.pain4Desc);
  // Solution
  sT('solutionLabel',t.solutionLabel);sH('solutionTitle',t.solutionTitle);
  sH('problemText',t.problemText);
  sH('solutionText',t.solutionText);
  sT('feat1Title',t.feat1Title);sT('feat1Desc',t.feat1Desc);
  sT('feat2Title',t.feat2Title);sT('feat2Desc',t.feat2Desc);
  sT('feat3Title',t.feat3Title);sT('feat3Desc',t.feat3Desc);
  sT('feat4Title',t.feat4Title);sT('feat4Desc',t.feat4Desc);
  sT('feat5Title',t.feat5Title);sT('feat5Desc',t.feat5Desc);
  sT('feat6Title',t.feat6Title);sT('feat6Desc',t.feat6Desc);
  // Results
  sT('resultsLabel',t.resultsLabel);sH('resultsTitle',t.resultsTitle);
  // Process
  sT('processLabel',t.processLabel);sH('processTitle',t.processTitle);
  sT('step1Title',t.step1Title);sT('step1Desc',t.step1Desc);
  sT('step2Title',t.step2Title);sT('step2Desc',t.step2Desc);
  sT('step3Title',t.step3Title);sT('step3Desc',t.step3Desc);
  sT('step4Title',t.step4Title);sT('step4Desc',t.step4Desc);
  // Proof
  sT('refsLabel',t.refsLabel);sH('refsTitle',t.refsTitle);
  sT('test1',t.test1);sT('test2',t.test2);sT('test3',t.test3);
  // Pricing
  sT('pricingLabel',t.pricingLabel);sH('pricingTitle',t.pricingTitle);
  // Bars and legend
  sT('resultsSubtitle',t.resultsSubtitle);
  sT('bar1Label',t.bar1Label);sT('bar2Label',t.bar2Label);sT('bar3Label',t.bar3Label);
  sT('legend1',t.legend1);sT('legend2',t.legend2);sT('legend3',t.legend3);
  // Pricing extras
  sT('pricingSubtitle',t.pricingSubtitle);
  sT('priceFreeNote',t.priceFreeNote);sT('pricePremNote',t.pricePremNote);
  sT('priceFreeCta',t.priceFreeCta);sT('pricePremCta',t.pricePremCta);
  sT('finalNote',t.finalNote);sT('pricingFooter',t.pricingFooter);
  // FAQ
  sT('faqLabel',t.faqLabel);sT('faqTitle',t.faqTitle);
  sT('faq1Q',t.faq1Q);sT('faq1A',t.faq1A);
  sT('faq2Q',t.faq2Q);sT('faq2A',t.faq2A);
  sT('faq3Q',t.faq3Q);sT('faq3A',t.faq3A);
  sT('faq4Q',t.faq4Q);sT('faq4A',t.faq4A);
  sT('faq5Q',t.faq5Q);sT('faq5A',t.faq5A);
  sT('faq6Q',t.faq6Q);sT('faq6A',t.faq6A);

  // Pricing list items
  sT('priceFree1',t.priceFree1);sT('priceFree2',t.priceFree2);sT('priceFree3',t.priceFree3);
  sT('priceFree4',t.priceFree4);sT('priceFree5',t.priceFree5);sT('priceFree6',t.priceFree6);sT('priceFree7',t.priceFree7);
  sT('pricePrem1',t.pricePrem1);sT('pricePrem2',t.pricePrem2);sT('pricePrem3',t.pricePrem3);
  sT('pricePrem4',t.pricePrem4);sT('pricePrem5',t.pricePrem5);sT('pricePrem6',t.pricePrem6);sT('pricePrem7',t.pricePrem7);
  // Testimonials (test1/test2/test3 already wired above)
  // Final CTA
  sH('finalHeadline',t.finalHeadline);sT('finalSub',t.finalSub);sT('finalBtn',t.finalBtn);
  // Popup
  qT('.popup-eyebrow',t.popupEyebrow);
  qH('.popup-title',t.popupTitle);
  qT('.popup-subtitle',t.popupSubtitle);
  qT('.popup-price-period',t.popupPricePeriod);qT('.popup-price-cancel',t.popupPriceCancel);
  const feats=document.querySelectorAll('.popup-feature');
  ['popupFeature1','popupFeature2','popupFeature3','popupFeature4','popupFeature5'].forEach((k,i)=>{if(feats[i])feats[i].childNodes[feats[i].childNodes.length-1].textContent=t[k];});
  qT('.popup-email-label',t.popupEmailLabel);
  const pei=document.getElementById('popupEmailInput');if(pei)pei.placeholder=t.popupEmailPlaceholder;
  qT('.popup-btn-secondary',t.popupTryFree);
  const trusts=document.querySelectorAll('.popup-trust-item');
  ['popupTrust1','popupTrust2','popupTrust3'].forEach((k,i)=>{if(trusts[i])trusts[i].innerHTML=t[k];});
  // Ticker
  const tickerItems=document.querySelectorAll('.ticker-item');
  const tv=['ticker1','ticker2','ticker3','ticker4','ticker5','ticker6','ticker7','ticker8'];
  tickerItems.forEach((item,i)=>{item.innerHTML=t[tv[i%tv.length]];});
  // Clans
  sT('clanSectionLabel',t.clanLabel);sH('clanTagline',t.clanTagline);sT('clanDesc',t.clanDesc);
  sT('clanPerk1Title',t.clanPerk1Title);sT('clanPerk1Desc',t.clanPerk1Desc);
  sT('clanPerk2Title',t.clanPerk2Title);sT('clanPerk2Desc',t.clanPerk2Desc);
  sT('clanPerk3Title',t.clanPerk3Title);sT('clanPerk3Desc',t.clanPerk3Desc);
  sT('clanPerk4Title',t.clanPerk4Title);sT('clanPerk4Desc',t.clanPerk4Desc);
  sT('clanYouLabel',t.clanYouLabel);sT('clanCodeLabel',t.clanCodeLabel);
  // Referral sekcia
  sT('refSectionLabel',t.refSectionLabel);sH('refSectionTitle',t.refSectionTitle);
  sT('refSectionDesc',t.refSectionDesc);
  sT('refStep1Title',t.refStep1Title);sT('refStep1Desc',t.refStep1Desc);
  sT('refStep2Title',t.refStep2Title);sT('refStep2Desc',t.refStep2Desc);
  sT('refStep3Title',t.refStep3Title);sT('refStep3Desc',t.refStep3Desc);
  sT('refExampleLabel',t.refExampleLabel);
  sT('refTier1',t.refTier1);sT('refTier2',t.refTier2);sT('refTier3',t.refTier3);
  sT('refWho1',t.refWho1);sT('refWho2',t.refWho2);sT('refWho3',t.refWho3);
  sT('refReward1Desc',t.refReward1Desc);sT('refReward2Desc',t.refReward2Desc);
  sT('refBonusTitle',t.refBonusTitle);sT('refBonusDesc',t.refBonusDesc);
  const popupRefLbl=document.getElementById('popupRefLabel');if(popupRefLbl)popupRefLbl.textContent=t.refPopupLabel;
  const popupRefIn=document.getElementById('popupRefInput');if(popupRefIn)popupRefIn.placeholder=t.refPopupPlaceholder;
  const popupRefBtnEl=document.getElementById('popupRefBtn');if(popupRefBtnEl)popupRefBtnEl.textContent=t.refValidating?'Overiť':'Verify';
  // Popup button
  const lbl=document.querySelector('#popupMainBtn .popup-btn-label');
  if(lbl)lbl.textContent=getStoredEmail()?t.popupMainBtnLoggedIn:t.popupMainBtnLoggedOut;
}

document.addEventListener('DOMContentLoaded',()=>setLanguage(detectInitialLanguage()));

// ── CURSOR ──
const cursor=document.getElementById('cursor'),ring=document.getElementById('cursorRing');
let mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cursor.style.left=mx+'px';cursor.style.top=my+'px';});
(function animRing(){rx+=(mx-rx)*.12;ry+=(my-ry)*.12;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(animRing);})();
document.querySelectorAll('a,button,.pain-card,.feature-card,.clan-mockup').forEach(el=>{
  el.addEventListener('mouseenter',()=>{cursor.style.width='20px';cursor.style.height='20px';ring.style.width='60px';ring.style.height='60px';});
  el.addEventListener('mouseleave',()=>{cursor.style.width='10px';cursor.style.height='10px';ring.style.width='36px';ring.style.height='36px';});
});

// ── NAV SCROLL ──
window.addEventListener('scroll',()=>document.getElementById('mainNav').classList.toggle('scrolled',scrollY>50));

// ── REVEAL ──
const obs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible');});},{threshold:.12});
document.querySelectorAll('.reveal,.feature-card,.step-item').forEach(el=>obs.observe(el));

// ── PERCENTILE BARS ──
const barsObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      setTimeout(()=>{document.getElementById('bar1').style.width='42%';},200);
      setTimeout(()=>{document.getElementById('bar2').style.width='65%';},500);
      setTimeout(()=>{document.getElementById('bar3').style.width='85%';},800);
      barsObs.disconnect();
    }
  });
},{threshold:.3});
const pv=document.getElementById('percentileVisual');
if(pv){['bar1','bar2','bar3'].forEach(id=>document.getElementById(id).style.width='0%');barsObs.observe(pv);}

// ── FAQ ──
function toggleFaq(btn){
  const item=btn.closest('.faq-item');
  const answer=item.querySelector('.faq-answer');
  const isOpen=item.classList.contains('open');
  document.querySelectorAll('.faq-item.open').forEach(i=>{i.classList.remove('open');i.querySelector('.faq-answer').style.maxHeight='0';});
  if(!isOpen){item.classList.add('open');answer.style.maxHeight=answer.scrollHeight+'px';}
}

// ── PREMIUM POPUP ──
function getStoredEmail(){
  try{const raw=localStorage.getItem('sb-zrnqiwareacqyndwchsv-auth-token');if(raw){const p=JSON.parse(raw);return p?.user?.email||null;}}catch(e){}
  return null;
}

function openElitePopup(){
  document.getElementById('elitePopup').style.display='flex';
  setTimeout(()=>document.getElementById('popupEliteEmail').focus(),100);
}
function closeElitePopup(){
  document.getElementById('elitePopup').style.display='none';
}
async function submitEliteCheckout(){
  const email=document.getElementById('popupEliteEmail').value.trim();
  const refCode=document.getElementById('popupEliteRef').value.trim();
  const errEl=document.getElementById('popupEliteError');
  const btn=document.querySelector('#elitePopup .popup-submit-btn');
  if(!email||!email.includes('@')){
    errEl.textContent='Zadaj platný email.';errEl.style.display='block';return;
  }
  errEl.style.display='none';
  btn.textContent='⏳ Presmerovávam...';btn.disabled=true;
  try{
    const res=await fetch('/api/stripe/checkout',{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({email,plan:'elite',refCode:refCode||null})
    });
    const data=await res.json();
    if(data.url){window.location.href=data.url;}
    else{errEl.textContent=data.error||'Chyba platby.';errEl.style.display='block';btn.textContent='Nesmiem zlyhať →';btn.disabled=false;}
  }catch(e){
    errEl.textContent='Chyba siete.';errEl.style.display='block';
    btn.textContent='Nesmiem zlyhať →';btn.disabled=false;
  }
}

function openPremiumPopup(){
  const overlay=document.getElementById('premiumPopup');
  const emailWrap=document.getElementById('popupEmailWrap');
  const errEl=document.getElementById('popupError');
  const btn=document.getElementById('popupMainBtn');
  errEl.classList.remove('show');errEl.textContent='';btn.disabled=false;btn.classList.remove('loading');
  const storedEmail=getStoredEmail();
  emailWrap.classList.toggle('show',!storedEmail);
  // Ref pole vždy viditeľné (aj prihlásený môže zadať kód kamaráta)
  const savedRef=localStorage.getItem('vsp_pending_ref');
  const refInput=document.getElementById('popupRefInput');
  if(refInput&&savedRef){refInput.value=savedRef;
    const rr=document.getElementById('popupRefResult');
    if(rr){rr.className='popup-ref-result ok';rr.textContent=translations[currentLang].refValidOk||'+14 dní pre oboch! ✓';}
  }
  const lbl=btn.querySelector('.popup-btn-label');
  if(lbl)lbl.textContent=translations[currentLang][storedEmail?'popupMainBtnLoggedIn':'popupMainBtnLoggedOut'];
  overlay.classList.add('active');document.body.style.overflow='hidden';
}
function closePremiumPopup(){document.getElementById('premiumPopup').classList.remove('active');document.body.style.overflow='';}
function closePremiumPopupOnOverlay(e){if(e.target===document.getElementById('premiumPopup'))closePremiumPopup();}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closePremiumPopup();});


// ── REFERRAL POPUP ────────────────────────────────────────────
async function validateRefOnPopup(){
  const input=document.getElementById('popupRefInput');
  const resultEl=document.getElementById('popupRefResult');
  if(!input||!resultEl)return;
  const code=input.value.trim().toUpperCase();
  if(code.length<6){
    if(code.length>0){resultEl.className='popup-ref-result err';resultEl.textContent=translations[currentLang].refValidErr||'Krátky kód';}
    return;
  }
  resultEl.className='popup-ref-result';
  resultEl.textContent=translations[currentLang].refValidating||'Overujem...';
  try{
    const res=await fetch('https://sptrener.online/api/referral/validate',{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({code})
    });
    const data=await res.json();
    if(data.valid){
      resultEl.className='popup-ref-result ok';
      resultEl.textContent=translations[currentLang].refValidOk||'+14 dní pre oboch! ✓';
      localStorage.setItem('vsp_pending_ref',code);
    }else{
      resultEl.className='popup-ref-result err';
      resultEl.textContent=translations[currentLang].refValidErr||'Neplatný kód';
      localStorage.removeItem('vsp_pending_ref');
    }
  }catch(e){
    resultEl.className='popup-ref-result err';
    resultEl.textContent='⚠️ Chyba siete';
  }
}

async function handlePremiumCheckout(){
  const btn=document.getElementById('popupMainBtn');
  const errEl=document.getElementById('popupError');
  errEl.classList.remove('show');
  let email=getStoredEmail();
  if(!email){
    const input=document.getElementById('popupEmailInput');
    email=input.value.trim();
    if(!email||!email.includes('@')){errEl.textContent=translations[currentLang].popupErrorInvalidEmail;errEl.classList.add('show');input.focus();return;}
  }
  btn.disabled=true;btn.classList.add('loading');
  try{
    const pendingRef=localStorage.getItem('vsp_pending_ref')||null;
    const res=await fetch('https://sptrener.online/api/stripe/checkout',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,refCode:pendingRef})});
    const data=await res.json();
    if(data.url){window.location.href=data.url;}
    else{throw new Error(data.error||translations[currentLang].popupErrorCheckout);}
  }catch(err){
    errEl.textContent=err.message||'Nastala chyba.';errEl.classList.add('show');
    btn.disabled=false;btn.classList.remove('loading');
  }
}
const urlParams=new URLSearchParams(window.location.search);
if(urlParams.get('premium')==='1'){
  document.addEventListener('DOMContentLoaded',()=>{
    setTimeout(()=>{
      const toast=document.createElement('div');
      toast.style.cssText='position:fixed;bottom:2rem;left:50%;transform:translateX(-50%);background:var(--green);color:var(--black);padding:.75rem 1.5rem;border-radius:10px;font-family:var(--mono);font-size:.85rem;font-weight:700;z-index:9999;box-shadow:0 8px 30px rgba(54,232,150,.4);';
      toast.textContent=translations[currentLang].premiumToast;
      localStorage.removeItem('vsp_pending_ref');document.body.appendChild(toast);setTimeout(()=>toast.remove(),5000);
    },500);
  });
}
</script>
</body>
</html>