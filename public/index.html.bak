<!DOCTYPE html>
<html lang="sk">
<head>
<script>
(function(){
  try {
    // Supabase v2 — kľúč je 'sb-<project-ref>-auth-token'
    var PROJECT_REF = 'zrnqiwareacqyndwchsv';
    var key = 'sb-' + PROJECT_REF + '-auth-token';
    var raw = localStorage.getItem(key);
    if (raw) {
      var session = JSON.parse(raw);
      // Skontroluj či token nie je expirovaný
      var expiresAt = session.expires_at || 0;
      if (expiresAt > Math.floor(Date.now() / 1000)) {
        window.location.replace('/app');
      }
    }
  } catch(e) {}
})();

// ── Partner referral banner ──────────────────────────────────
(function() {
  const params = new URLSearchParams(window.location.search);
  const ref = params.get('ref');
  if (!ref) return;

  // Ulož ref kód do sessionStorage pre checkout
  sessionStorage.setItem('partner_ref', ref.toUpperCase());

  // Načítaj info o partnerovi
  fetch('/api/partner/ref/' + encodeURIComponent(ref))
    .then(r => r.json())
    .then(data => {
      if (!data.name) return;
      const banner = document.getElementById('partnerBanner');
      document.getElementById('bannerName').textContent = data.name;
      document.getElementById('bannerCode').textContent = data.refCode;
      banner.style.display = 'flex';
      document.body.classList.add('has-banner');
    })
    .catch(() => {});
})();

function copyRefCode() {
  const code = document.getElementById('bannerCode').textContent;
  navigator.clipboard.writeText(code).then(() => {
    const el = document.getElementById('bannerCode');
    const orig = el.textContent;
    el.textContent = '✓ Skopírované';
    setTimeout(() => el.textContent = orig, 1500);
  });
}

function closeBanner() {
  document.getElementById('partnerBanner').style.display = 'none';
  document.body.classList.remove('has-banner');
}

</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VSP Tréner — Dostaň sa na percentil 85</title>
<meta name="description" content="AI-powered tréner na SCIO VSP testy. Neobmedzené testy, personalizovaná analýza, reálna simulácia. Prvé 3 testy zadarmo.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Mono:wght@300;400;500&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,700&display=swap" rel="stylesheet">
<style>
:root{--black:#08080d;--black2:#0f0f18;--black3:#171724;--border:rgba(255,255,255,.07);--border2:rgba(255,255,255,.13);--text:#eeeef5;--text2:#7777a0;--text3:#3d3d5c;--volt:#c8ff00;--purple:#7c5cff;--purple2:#b09bff;--red:#ff3f5e;--green:#36e896;--yellow:#ffc94d;--serif:'Instrument Serif',Georgia,serif;--mono:'DM Mono',monospace;--sans:'DM Sans',sans-serif}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--black);color:var(--text);font-family:var(--sans);overflow-x:hidden;cursor:none}
.cursor{position:fixed;width:10px;height:10px;background:var(--volt);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:transform .1s,width .2s,height .2s,background .2s;mix-blend-mode:difference}
.cursor-ring{position:fixed;width:36px;height:36px;border:1px solid rgba(200,255,0,.4);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:transform .15s ease-out,width .25s,height .25s}
body::after{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");pointer-events:none;z-index:9997}
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:1.25rem 2.5rem;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid transparent;transition:border-color .3s,background .3s}
nav.scrolled{background:rgba(8,8,13,.9);backdrop-filter:blur(12px);border-color:var(--border)}
.nav-logo{font-family:var(--mono);font-size:13px;letter-spacing:.15em;color:var(--text);text-decoration:none;display:flex;align-items:center;gap:.5rem}
.nav-dot{width:7px;height:7px;background:var(--volt);border-radius:50%;animation:pulse-dot 2s infinite}
@keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.7)}}
.nav-cta{display:flex;align-items:center;gap:.5rem;padding:.55rem 1.25rem;background:var(--volt);color:var(--black);border-radius:6px;font-size:.82rem;font-weight:700;letter-spacing:.04em;text-decoration:none;transition:all .2s;font-family:var(--mono);cursor:pointer;border:none}
.nav-cta:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(200,255,0,.3)}
.hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:8rem 2rem 4rem;position:relative;text-align:center;overflow:hidden}
.hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(124,92,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(124,92,255,.04) 1px,transparent 1px);background-size:60px 60px;mask-image:radial-gradient(ellipse 80% 80% at 50% 50%,black,transparent)}
.hero-orb{position:absolute;border-radius:50%;pointer-events:none;filter:blur(80px);animation:orb-float 8s ease-in-out infinite}
.hero-orb-1{width:500px;height:500px;background:rgba(124,92,255,.12);top:-100px;left:-100px}
.hero-orb-2{width:400px;height:400px;background:rgba(200,255,0,.06);bottom:-50px;right:-50px;animation-delay:-4s}
.hero-orb-3{width:300px;height:300px;background:rgba(255,63,94,.07);top:40%;right:10%;animation-delay:-2s}
@keyframes orb-float{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(30px,-30px) scale(1.05)}66%{transform:translate(-20px,20px) scale(.95)}}
.hero-eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.3em;color:var(--volt);text-transform:uppercase;margin-bottom:1.75rem;position:relative;z-index:1;opacity:0;animation:fade-up .8s ease .2s forwards}
.hero-headline{font-family:var(--serif);font-size:clamp(3rem,7vw,6.5rem);line-height:1.05;letter-spacing:-.02em;position:relative;z-index:1;max-width:900px;margin-bottom:1.5rem;opacity:0;animation:fade-up .8s ease .4s forwards}
.hero-headline em{font-style:italic;color:var(--purple2)}
.hero-headline .volt-text{color:var(--volt);font-style:normal}
.hero-sub{font-size:1.1rem;color:var(--text2);font-weight:300;max-width:520px;line-height:1.7;position:relative;z-index:1;margin-bottom:2.5rem;opacity:0;animation:fade-up .8s ease .6s forwards}
.hero-actions{display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;position:relative;z-index:1;opacity:0;animation:fade-up .8s ease .8s forwards}
.btn-primary{display:inline-flex;align-items:center;gap:.6rem;padding:1rem 2rem;background:var(--volt);color:var(--black);border-radius:8px;font-weight:700;font-size:.95rem;text-decoration:none;font-family:var(--mono);letter-spacing:.03em;transition:all .2s;position:relative;overflow:hidden;cursor:pointer;border:none}
.btn-primary::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent,rgba(255,255,255,.2),transparent);transform:translateX(-100%);transition:transform .4s}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(200,255,0,.35)}
.btn-primary:hover::before{transform:translateX(100%)}
.btn-secondary{display:inline-flex;align-items:center;gap:.6rem;padding:1rem 2rem;background:transparent;color:var(--text2);border:1px solid var(--border2);border-radius:8px;font-size:.9rem;text-decoration:none;transition:all .2s}
.btn-secondary:hover{border-color:var(--purple);color:var(--text)}
.hero-stats{display:flex;gap:0;margin-top:4rem;border:1px solid var(--border);border-radius:12px;overflow:hidden;position:relative;z-index:1;opacity:0;animation:fade-up .8s ease 1s forwards;background:rgba(15,15,24,.6);backdrop-filter:blur(10px)}
.hero-stat{padding:1.25rem 2rem;border-right:1px solid var(--border);text-align:center}
.hero-stat:last-child{border-right:none}
.hero-stat-val{font-family:var(--mono);font-size:1.6rem;font-weight:500;color:var(--text);display:block}
.hero-stat-val span{color:var(--volt)}
.hero-stat-label{font-size:.72rem;color:var(--text3);letter-spacing:.1em;text-transform:uppercase;font-family:var(--mono);margin-top:.25rem;display:block}
@keyframes fade-up{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
.section{padding:6rem 2rem;max-width:1100px;margin:0 auto}
.section-label{font-family:var(--mono);font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:var(--text3);margin-bottom:1rem;display:flex;align-items:center;gap:.75rem}
.section-label::after{content:'';flex:1;height:1px;background:var(--border)}
.section-title{font-family:var(--serif);font-size:clamp(2rem,4vw,3.5rem);line-height:1.1;letter-spacing:-.02em;margin-bottom:1.5rem}
.section-title em{font-style:italic;color:var(--purple2)}
.pain-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1px;background:var(--border);border:1px solid var(--border);border-radius:16px;overflow:hidden;margin-top:3rem}
.pain-card{background:var(--black2);padding:2rem;position:relative;overflow:hidden;transition:background .2s}
.pain-card:hover{background:var(--black3)}
.pain-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--red);transform:scaleX(0);transform-origin:left;transition:transform .3s}
.pain-card:hover::before{transform:scaleX(1)}
.pain-number{font-family:var(--mono);font-size:3.5rem;font-weight:300;color:var(--border2);line-height:1;margin-bottom:1rem}
.pain-title{font-size:1.05rem;font-weight:600;margin-bottom:.5rem;color:var(--text)}
.pain-desc{font-size:.88rem;color:var(--text2);line-height:1.65}
.solution-section{padding:6rem 2rem;background:var(--black2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);position:relative;overflow:hidden}
.solution-section::before{content:'';position:absolute;top:-200px;right:-200px;width:600px;height:600px;background:radial-gradient(circle,rgba(124,92,255,.08) 0%,transparent 70%);pointer-events:none}
.solution-inner{max-width:1100px;margin:0 auto}
.feature-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-top:3rem}
@media(max-width:768px){.feature-grid{grid-template-columns:1fr}}
.feature-card{background:var(--black);border:1px solid var(--border);border-radius:14px;padding:1.75rem;position:relative;overflow:hidden;transition:all .25s;opacity:0;transform:translateY(20px)}
.feature-card.visible{opacity:1;transform:translateY(0)}
.feature-card:hover{border-color:var(--purple);box-shadow:0 0 30px rgba(124,92,255,.1)}
.feature-card.highlight{border-color:rgba(200,255,0,.2);background:linear-gradient(135deg,var(--black),rgba(200,255,0,.03))}
.feature-card.highlight:hover{border-color:rgba(200,255,0,.4);box-shadow:0 0 30px rgba(200,255,0,.08)}
.feature-icon{font-size:1.75rem;margin-bottom:1rem;display:block}
.feature-title{font-size:1.05rem;font-weight:700;margin-bottom:.5rem}
.feature-desc{font-size:.88rem;color:var(--text2);line-height:1.65}
.feature-tag{display:inline-flex;align-items:center;gap:.3rem;padding:3px 10px;background:rgba(200,255,0,.08);color:var(--volt);border-radius:20px;font-size:10px;font-family:var(--mono);letter-spacing:.1em;margin-top:.75rem}

/* ── CLAN SECTION ── */
.clan-section{padding:6rem 2rem;background:var(--black);border-top:1px solid var(--border);position:relative;overflow:hidden}
.clan-section::before{content:'';position:absolute;top:-200px;left:-200px;width:600px;height:600px;background:radial-gradient(circle,rgba(124,92,255,.07) 0%,transparent 70%);pointer-events:none}
.clan-section::after{content:'';position:absolute;bottom:-100px;right:-100px;width:400px;height:400px;background:radial-gradient(circle,rgba(200,255,0,.04) 0%,transparent 70%);pointer-events:none}
.clan-inner{max-width:1100px;margin:0 auto;position:relative;z-index:1}
.clan-layout{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;margin-top:3rem}
@media(max-width:900px){.clan-layout{grid-template-columns:1fr;gap:2.5rem}}
.clan-code-demo{display:inline-flex;align-items:center;gap:.5rem;background:rgba(124,92,255,.1);border:1px solid rgba(124,92,255,.25);border-radius:8px;padding:.4rem 1rem;font-family:var(--mono);font-size:1rem;letter-spacing:.2em;color:var(--purple2);margin-bottom:1.25rem}
.clan-code-dot{width:6px;height:6px;border-radius:50%;background:var(--volt);animation:pulse-dot 2s infinite}
.clan-tagline{font-family:var(--serif);font-size:clamp(1.75rem,3.5vw,2.75rem);line-height:1.12;letter-spacing:-.02em;margin-bottom:1rem}
.clan-tagline em{font-style:italic;color:var(--purple2)}
.clan-desc{font-size:.92rem;color:var(--text2);line-height:1.75;margin-bottom:2rem}
.clan-perks{display:flex;flex-direction:column;gap:.85rem}
.clan-perk{display:flex;align-items:flex-start;gap:.75rem}
.clan-perk-icon{width:32px;height:32px;border-radius:8px;background:var(--black2);border:1px solid var(--border2);display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0;margin-top:1px}
.clan-perk-text{font-size:.88rem;color:var(--text2);line-height:1.55}
.clan-perk-text strong{color:var(--text);display:block;margin-bottom:.15rem;font-size:.9rem}
.clan-visual-col{position:relative}
.clan-mockup{background:var(--black2);border:1px solid var(--border2);border-radius:20px;overflow:hidden;box-shadow:0 40px 80px rgba(0,0,0,.5),0 0 0 1px rgba(124,92,255,.1)}
.clan-mockup-header{padding:1rem 1.25rem;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:.5rem;background:rgba(15,15,24,.8)}
.clan-mockup-dot{width:8px;height:8px;border-radius:50%}
.clan-mockup-title{font-family:var(--mono);font-size:.75rem;color:var(--text3);letter-spacing:.1em;margin-left:.35rem;flex:1}
.clan-mockup-badge{font-family:var(--mono);font-size:.65rem;color:var(--volt);background:rgba(200,255,0,.08);border:1px solid rgba(200,255,0,.2);padding:2px 8px;border-radius:20px;letter-spacing:.1em;animation:pulse-dot 2s infinite}
.clan-lb-row{display:grid;grid-template-columns:32px 1fr auto auto;align-items:center;gap:.75rem;padding:.7rem 1.25rem;border-bottom:1px solid var(--border)}
.clan-lb-row:last-child{border-bottom:none}
.clan-lb-row.me{background:rgba(124,92,255,.07)}
.clan-lb-rank{font-family:var(--mono);font-size:.78rem;font-weight:700;text-align:center}
.clan-lb-rank.r1{color:#ffd700}.clan-lb-rank.r2{color:#b0b8c1}.clan-lb-rank.r3{color:#cd7f32}.clan-lb-rank.r4{color:var(--text3)}
.clan-lb-name{font-size:.85rem;font-weight:600;color:var(--text);display:flex;align-items:center;gap:.4rem}
.clan-lb-you{font-family:var(--mono);font-size:.6rem;color:var(--purple2);background:rgba(124,92,255,.12);border-radius:4px;padding:1px 5px}
.clan-lb-percentile{font-family:var(--mono);font-size:.8rem;color:var(--volt);font-weight:600;text-align:right}
.clan-lb-streak{font-family:var(--mono);font-size:.75rem;color:var(--text3);text-align:right}
.clan-mockup-footer{padding:.85rem 1.25rem;background:rgba(200,255,0,.03);border-top:1px solid rgba(200,255,0,.08);display:flex;align-items:center;justify-content:space-between}
.clan-mockup-code{font-family:var(--mono);font-size:.7rem;color:var(--text3);display:flex;align-items:center;gap:.4rem}
.clan-mockup-code b{color:var(--volt);letter-spacing:.15em}
.clan-premium-badge{font-family:var(--mono);font-size:.65rem;color:var(--black);background:var(--volt);border-radius:4px;padding:2px 7px;letter-spacing:.08em;font-weight:700}
.clan-float-1{position:absolute;top:-20px;right:-20px;width:120px;height:120px;background:radial-gradient(circle,rgba(124,92,255,.15) 0%,transparent 70%);border-radius:50%;pointer-events:none}
.clan-float-2{position:absolute;bottom:-30px;left:-30px;width:100px;height:100px;background:radial-gradient(circle,rgba(200,255,0,.08) 0%,transparent 70%);border-radius:50%;pointer-events:none}

.percentile-section{padding:6rem 2rem;max-width:1100px;margin:0 auto}
.percentile-visual{margin-top:3rem;background:var(--black2);border:1px solid var(--border);border-radius:20px;padding:2.5rem;position:relative;overflow:hidden}
.percentile-bar-container{margin-bottom:1.5rem}
.percentile-bar-label{display:flex;justify-content:space-between;font-family:var(--mono);font-size:11px;color:var(--text3);letter-spacing:.1em;margin-bottom:.5rem}
.percentile-bar-track{height:12px;background:var(--black3);border-radius:6px;overflow:hidden;position:relative}
.percentile-bar-fill{height:100%;border-radius:6px;transition:width 1.5s cubic-bezier(.22,1,.36,1);position:relative}
.percentile-bar-fill.gray{background:var(--text3);width:0%}
.percentile-bar-fill.purple{background:linear-gradient(90deg,var(--purple),var(--purple2));width:0%}
.percentile-bar-fill.volt{background:linear-gradient(90deg,var(--volt),#a0ff00);width:0%}
.percentile-bar-fill::after{content:'';position:absolute;top:0;right:0;height:100%;width:20px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.3))}
.percentile-legend{display:flex;gap:1.5rem;flex-wrap:wrap;margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid var(--border)}
.legend-item{display:flex;align-items:center;gap:.5rem;font-size:.82rem;color:var(--text2);font-family:var(--mono)}
.legend-dot{width:8px;height:8px;border-radius:2px}
.how-section{padding:6rem 2rem;background:var(--black2);border-top:1px solid var(--border)}
.how-inner{max-width:1100px;margin:0 auto}
.steps-timeline{margin-top:3rem;display:flex;flex-direction:column;gap:0}
.step-item{display:grid;grid-template-columns:80px 1fr;gap:2rem;padding-bottom:2.5rem;position:relative;opacity:0;transform:translateX(-20px);transition:opacity .5s,transform .5s}
.step-item.visible{opacity:1;transform:translateX(0)}
.step-item:not(:last-child)::before{content:'';position:absolute;left:39px;top:60px;bottom:0;width:1px;background:linear-gradient(to bottom,var(--border2),transparent)}
.step-num{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:.85rem;font-weight:500;flex-shrink:0;border:1px solid var(--border2);background:var(--black);color:var(--text2);transition:all .2s}
.step-item:hover .step-num{border-color:var(--volt);color:var(--volt);background:rgba(200,255,0,.05)}
.step-content{padding-top:.6rem}
.step-title{font-size:1.05rem;font-weight:600;margin-bottom:.4rem}
.step-desc{font-size:.88rem;color:var(--text2);line-height:1.65}
.proof-section{padding:6rem 2rem;max-width:1100px;margin:0 auto}
.testimonials-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem;margin-top:3rem}
.testimonial-card{background:var(--black2);border:1px solid var(--border);border-radius:14px;padding:1.5rem;position:relative;transition:all .2s}
.testimonial-card:hover{border-color:var(--border2);transform:translateY(-2px)}
.testimonial-quote{font-family:var(--serif);font-size:1.05rem;font-style:italic;line-height:1.65;color:var(--text);margin-bottom:1.25rem;position:relative}
.testimonial-quote::before{content:'"';font-size:3rem;color:var(--purple);line-height:1;display:block;margin-bottom:-.5rem}
.testimonial-author{display:flex;align-items:center;gap:.75rem}
.author-avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--purple),var(--red));display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:700;color:white;flex-shrink:0}
.author-name{font-size:.88rem;font-weight:600}
.author-detail{font-size:.78rem;color:var(--text3);font-family:var(--mono)}
.percentile-badge{margin-left:auto;font-family:var(--mono);font-size:.72rem;color:var(--volt);background:rgba(200,255,0,.08);padding:3px 10px;border-radius:20px}
.pricing-section{padding:6rem 2rem;background:var(--black2);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.pricing-inner{max-width:860px;margin:0 auto}
.pricing-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1.25rem;margin-top:3rem}
@media(max-width:900px){.pricing-grid{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.pricing-grid{grid-template-columns:1fr}}
.pricing-card{background:var(--black);border:1px solid var(--border);border-radius:20px;padding:2rem;position:relative;overflow:hidden;transition:all .25s}
.pricing-card.featured{border-color:rgba(124,92,255,.5);background:linear-gradient(135deg,var(--black),rgba(124,92,255,.04))}
.pricing-card.featured::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,#7c5cff,#ff3f5e)}
.pricing-card.recommended{border-color:var(--volt);background:linear-gradient(135deg,var(--black),rgba(200,255,0,.03))}
.pricing-card.recommended::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--volt)}
.pricing-badge{display:inline-block;font-family:var(--mono);font-size:10px;letter-spacing:.15em;padding:4px 12px;border-radius:20px;margin-bottom:1.25rem}
.pricing-badge.free-badge{background:rgba(255,255,255,.06);color:var(--text3)}
.pricing-badge.premium-badge{background:rgba(200,255,0,.12);color:var(--volt)}
.pricing-badge.elite-badge{background:rgba(255,63,94,.12);color:var(--red,#ff3f5e);border:1px solid rgba(255,63,94,.2)}
.pricing-price{font-family:var(--mono);font-size:3rem;font-weight:500;line-height:1;margin-bottom:.35rem}
.pricing-price sup{font-size:1.25rem;vertical-align:super;margin-right:2px}
.pricing-price-note{font-size:.8rem;color:var(--text3);font-family:var(--mono);margin-bottom:1.75rem}
.pricing-features{list-style:none;margin-bottom:2rem;display:flex;flex-direction:column;gap:.65rem}
.pricing-features li{font-size:.88rem;color:var(--text2);display:flex;align-items:flex-start;gap:.6rem;line-height:1.5}
.pricing-features li::before{content:'→';color:var(--purple2);flex-shrink:0;font-family:var(--mono);font-size:.8rem;margin-top:1px}
.pricing-features li.included::before{content:'✓';color:var(--green)}
.pricing-features li.excluded{color:var(--text3)}
.pricing-features li.excluded::before{content:'×';color:var(--text3)}
.pricing-cta{display:block;width:100%;padding:.9rem;text-align:center;border-radius:10px;font-weight:700;font-size:.88rem;font-family:var(--mono);letter-spacing:.05em;text-decoration:none;transition:all .2s;cursor:pointer;border:none}
.pricing-cta.free-cta{background:transparent;border:1px solid var(--border2);color:var(--text2)}
.pricing-cta.free-cta:hover{border-color:var(--text2);color:var(--text)}
.pricing-cta.premium-cta{background:var(--volt);color:var(--black)}
.pricing-cta.premium-cta:hover{transform:translateY(-1px);box-shadow:0 8px 25px rgba(200,255,0,.3)}
.pricing-cta.elite-cta{background:linear-gradient(135deg,#7c5cff,#ff3f5e);color:#fff}
.pricing-cta.elite-cta:hover{transform:translateY(-1px);box-shadow:0 8px 25px rgba(124,92,255,.4)}
.faq-section{padding:6rem 2rem;max-width:760px;margin:0 auto}
.faq-item{border-bottom:1px solid var(--border);overflow:hidden}
.faq-question{width:100%;padding:1.25rem 0;display:flex;align-items:center;justify-content:space-between;gap:1rem;background:none;border:none;color:var(--text);text-align:left;cursor:pointer;font-size:.95rem;font-weight:500;font-family:var(--sans);transition:color .2s}
.faq-question:hover{color:var(--volt)}
.faq-arrow{flex-shrink:0;font-family:var(--mono);font-size:1rem;color:var(--text3);transition:transform .3s,color .2s}
.faq-item.open .faq-arrow{transform:rotate(45deg);color:var(--volt)}
.faq-answer{max-height:0;overflow:hidden;transition:max-height .4s ease;font-size:.9rem;color:var(--text2);line-height:1.7}
.faq-answer-inner{padding-bottom:1.25rem}
.final-cta-section{padding:8rem 2rem;text-align:center;position:relative;overflow:hidden}
.final-cta-section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 60% at 50% 50%,rgba(124,92,255,.1),transparent);pointer-events:none}
.final-headline{font-family:var(--serif);font-size:clamp(2.5rem,5vw,5rem);line-height:1.08;letter-spacing:-.02em;max-width:800px;margin:0 auto 1.5rem;position:relative;z-index:1}
.final-headline em{font-style:italic;color:var(--purple2)}
.final-headline strong{color:var(--volt);font-style:normal;font-weight:inherit}
.final-sub{color:var(--text2);font-size:1rem;max-width:440px;margin:0 auto 2.5rem;line-height:1.7;position:relative;z-index:1}
footer{border-top:1px solid var(--border);padding:2.5rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem}
.footer-logo{font-family:var(--mono);font-size:12px;letter-spacing:.15em;color:var(--text3)}
.footer-links{display:flex;gap:1.5rem}
.footer-links a{font-size:.78rem;color:var(--text3);text-decoration:none;font-family:var(--mono);letter-spacing:.05em;transition:color .2s}
.footer-links a:hover{color:var(--text2)}
.reveal{opacity:0;transform:translateY(30px);transition:opacity .7s ease,transform .7s ease}
.reveal.visible{opacity:1;transform:translateY(0)}
.ticker-wrap{border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--black2);overflow:hidden;padding:.75rem 0}
.ticker-track{display:flex;gap:3rem;animation:ticker 30s linear infinite;white-space:nowrap}
.ticker-item{font-family:var(--mono);font-size:11px;letter-spacing:.15em;color:var(--text3);text-transform:uppercase;display:flex;align-items:center;gap:.75rem;flex-shrink:0}
.ticker-item span{color:var(--volt)}
@keyframes ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media(max-width:768px){nav{padding:1rem 1.5rem}.hero-stats{flex-direction:column;gap:0}.hero-stat{border-right:none;border-bottom:1px solid var(--border)}.hero-stat:last-child{border-bottom:none}footer{flex-direction:column;text-align:center}}

/* ── PREMIUM POPUP ── */
.premium-popup-overlay{position:fixed;inset:0;background:rgba(8,8,13,.85);backdrop-filter:blur(16px);z-index:10000;display:flex;align-items:center;justify-content:center;padding:1.5rem;opacity:0;pointer-events:none;transition:opacity .3s ease}
.premium-popup-overlay.active{opacity:1;pointer-events:all}
.premium-popup{background:var(--black2);border:1px solid rgba(200,255,0,.2);border-radius:24px;padding:0;max-width:480px;width:100%;position:relative;overflow:hidden;transform:translateY(24px) scale(.97);transition:transform .35s cubic-bezier(.22,1,.36,1);box-shadow:0 40px 100px rgba(0,0,0,.6),0 0 0 1px rgba(200,255,0,.08)}
.premium-popup-overlay.active .premium-popup{transform:translateY(0) scale(1)}
.premium-popup::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--volt),transparent)}
.premium-popup::after{content:'';position:absolute;top:-80px;right:-80px;width:250px;height:250px;background:radial-gradient(circle,rgba(200,255,0,.07) 0%,transparent 70%);pointer-events:none}
.popup-close{position:absolute;top:1rem;right:1rem;width:32px;height:32px;border-radius:8px;background:rgba(255,255,255,.06);border:1px solid var(--border);color:var(--text3);font-size:1rem;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;z-index:1;font-family:var(--mono);line-height:1}
.popup-close:hover{background:rgba(255,255,255,.1);color:var(--text)}
.popup-header{padding:2.25rem 2.25rem 0;position:relative;z-index:1}
.popup-eyebrow{font-family:var(--mono);font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:var(--volt);margin-bottom:.75rem;display:flex;align-items:center;gap:.5rem}
.popup-eyebrow::before{content:'';width:20px;height:1px;background:var(--volt)}
.popup-title{font-family:var(--serif);font-size:1.85rem;line-height:1.15;letter-spacing:-.02em;margin-bottom:.5rem}
.popup-title em{font-style:italic;color:var(--purple2)}
.popup-subtitle{font-size:.88rem;color:var(--text2);line-height:1.6}
.popup-price-block{margin:1.5rem 2.25rem;padding:1.25rem 1.5rem;background:rgba(200,255,0,.05);border:1px solid rgba(200,255,0,.15);border-radius:14px;display:flex;align-items:center;justify-content:space-between;gap:1rem}
.popup-price{font-family:var(--mono);font-size:2.5rem;font-weight:500;color:var(--volt);line-height:1}
.popup-price sup{font-size:1.1rem;vertical-align:super}
.popup-price-detail{text-align:right}
.popup-price-period{font-family:var(--mono);font-size:.75rem;color:var(--text3);letter-spacing:.05em}
.popup-price-cancel{font-size:.72rem;color:var(--text3);margin-top:2px}
.popup-features{padding:0 2.25rem;display:flex;flex-direction:column;gap:.55rem;margin-bottom:1.75rem}
.popup-feature{display:flex;align-items:center;gap:.65rem;font-size:.85rem;color:var(--text2)}
.popup-feature-icon{width:20px;height:20px;border-radius:6px;background:rgba(54,232,150,.12);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.65rem;color:var(--green);font-family:var(--mono);font-weight:700}
.popup-actions{padding:0 2.25rem 2.25rem;display:flex;flex-direction:column;gap:.75rem}
.popup-btn-primary{display:flex;align-items:center;justify-content:center;gap:.6rem;padding:1rem 1.5rem;background:var(--volt);color:var(--black);border:none;border-radius:12px;font-family:var(--mono);font-size:.9rem;font-weight:700;letter-spacing:.04em;cursor:pointer;transition:all .2s;position:relative;overflow:hidden;width:100%}
.popup-btn-primary::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent,rgba(255,255,255,.25),transparent);transform:translateX(-100%);transition:transform .4s}
.popup-btn-primary:hover{transform:translateY(-1px);box-shadow:0 8px 28px rgba(200,255,0,.35)}
.popup-btn-primary:hover::before{transform:translateX(100%)}
.popup-btn-primary:disabled{opacity:.6;cursor:not-allowed;transform:none}
.popup-btn-secondary{display:flex;align-items:center;justify-content:center;gap:.5rem;padding:.75rem;background:transparent;border:1px solid var(--border);border-radius:10px;color:var(--text3);font-size:.82rem;font-family:var(--mono);cursor:pointer;transition:all .2s;width:100%;text-decoration:none}
.popup-btn-secondary:hover{border-color:var(--border2);color:var(--text2)}
.popup-trust{display:flex;align-items:center;justify-content:center;gap:1rem;padding:1rem 2.25rem;border-top:1px solid var(--border);flex-wrap:wrap}
.popup-trust-item{display:flex;align-items:center;gap:.35rem;font-family:var(--mono);font-size:10px;letter-spacing:.08em;color:var(--text3);text-transform:uppercase}
.popup-trust-item span{color:var(--green)}
@keyframes spin{to{transform:rotate(360deg)}}
.popup-spinner{width:16px;height:16px;border:2px solid rgba(8,8,13,.3);border-top-color:var(--black);border-radius:50%;animation:spin .7s linear infinite;display:none}
.popup-btn-primary.loading .popup-spinner{display:block}
.popup-btn-primary.loading .popup-btn-label{display:none}
.popup-email-wrap{padding:0 2.25rem;margin-bottom:1rem;display:none}
.popup-email-wrap.show{display:block}
.popup-email-label{font-family:var(--mono);font-size:10px;letter-spacing:.15em;text-transform:uppercase;color:var(--text3);margin-bottom:.5rem;display:block}
.popup-email-input{width:100%;padding:.75rem 1rem;background:var(--black3);border:1px solid var(--border2);border-radius:10px;color:var(--text);font-family:var(--sans);font-size:.9rem;outline:none;transition:border-color .2s}
.popup-email-input:focus{border-color:var(--volt)}
.popup-email-input::placeholder{color:var(--text3)}
.popup-error{padding:0 2.25rem;margin-bottom:.75rem;font-size:.8rem;color:var(--red);font-family:var(--mono);display:none}
.popup-error.show{display:block}

/* ── LANG SWITCHER ── */
.lang-switcher{display:flex;align-items:center;gap:.35rem}
.lang-btn{padding:.45rem .7rem;border:1px solid var(--border2);background:transparent;color:var(--text2);border-radius:6px;font-family:var(--mono);font-size:.72rem;letter-spacing:.06em;cursor:pointer;transition:all .2s}
.lang-btn:hover{color:var(--text);border-color:var(--purple)}
.lang-btn.active{background:var(--volt);color:var(--black);border-color:var(--volt)}
@media(max-width:768px){.lang-btn{padding:.4rem .55rem;font-size:.68rem}}

/* ── REFERRAL SEKCIA ── */
.referral-section{padding:6rem 2rem;background:var(--black);border-top:1px solid var(--border)}
.referral-inner{max-width:860px;margin:0 auto}
.ref-layout{display:grid;grid-template-columns:1fr 1fr;gap:3.5rem;align-items:start;margin-top:3rem}
@media(max-width:768px){.ref-layout{grid-template-columns:1fr;gap:2rem}}
.ref-flow{display:flex;flex-direction:column;gap:1.25rem}
.ref-step{display:flex;gap:1rem;align-items:flex-start}
.ref-step-num{width:36px;height:36px;border-radius:10px;background:rgba(124,92,255,.12);border:1px solid rgba(124,92,255,.25);display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:.78rem;font-weight:700;color:var(--purple2);flex-shrink:0;margin-top:2px}
.ref-step-body{flex:1}
.ref-step-title{font-size:.92rem;font-weight:600;color:var(--text);margin-bottom:.2rem}
.ref-step-desc{font-size:.82rem;color:var(--text2);line-height:1.6}
.ref-rewards{display:flex;flex-direction:column;gap:1rem}
.ref-reward-card{background:var(--black2);border:1px solid var(--border);border-radius:14px;padding:1.25rem 1.5rem;position:relative;overflow:hidden;transition:border-color .2s}
.ref-reward-card:hover{border-color:var(--border2)}
.ref-reward-card.highlight{border-color:rgba(200,255,0,.2);background:linear-gradient(135deg,var(--black2),rgba(200,255,0,.03))}
.ref-reward-card.highlight::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--volt),var(--purple))}
.ref-reward-who{font-family:var(--mono);font-size:.68rem;letter-spacing:.15em;text-transform:uppercase;color:var(--text3);margin-bottom:.4rem}
.ref-reward-title{font-size:.95rem;font-weight:600;color:var(--text);margin-bottom:.25rem;display:flex;align-items:center;gap:.5rem}
.ref-reward-days{font-family:var(--mono);font-size:1.4rem;font-weight:500;color:var(--volt)}
.ref-reward-desc{font-size:.8rem;color:var(--text2);line-height:1.55}
.ref-code-example{display:inline-flex;align-items:center;gap:.6rem;background:rgba(200,255,0,.06);border:1px solid rgba(200,255,0,.18);border-radius:10px;padding:.55rem 1.1rem;font-family:var(--mono);font-size:1.1rem;font-weight:700;letter-spacing:.2em;color:var(--volt);margin:.75rem 0}
.ref-tier-row{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin-top:.75rem;padding-top:.75rem;border-top:1px solid var(--border)}
.ref-tier{display:inline-flex;align-items:center;gap:.3rem;font-family:var(--mono);font-size:.7rem;padding:3px 9px;border-radius:20px}
.ref-tier.t1{background:rgba(55,138,221,.1);color:#85b7eb;border:1px solid rgba(55,138,221,.2)}
.ref-tier.t2{background:rgba(124,92,255,.1);color:var(--purple2);border:1px solid rgba(124,92,255,.2)}
.ref-tier.t3{background:rgba(200,255,0,.08);color:var(--volt);border:1px solid rgba(200,255,0,.2)}
/* Ref pole v popupe */
.popup-ref-wrap{padding:0 2.25rem;margin-bottom:.75rem}
.popup-ref-label{font-family:var(--mono);font-size:10px;letter-spacing:.15em;text-transform:uppercase;color:var(--text3);margin-bottom:.4rem;display:block}
.popup-ref-row{display:flex;gap:.5rem}
.popup-ref-input{flex:1;padding:.65rem .9rem;background:var(--black3);border:1px solid var(--border2);border-radius:9px;color:var(--text);font-family:var(--mono);font-size:.85rem;letter-spacing:.12em;text-transform:uppercase;outline:none;transition:border-color .2s}
.popup-ref-input:focus{border-color:var(--purple)}
.popup-ref-input::placeholder{text-transform:none;letter-spacing:0;color:var(--text3);font-size:.8rem}
.popup-ref-btn{padding:.65rem .9rem;background:var(--black3);border:1px solid var(--border2);border-radius:9px;color:var(--text2);font-family:var(--mono);font-size:.76rem;cursor:pointer;transition:all .15s;white-space:nowrap}
.popup-ref-btn:hover{border-color:var(--purple);color:var(--text)}
.popup-ref-result{margin-top:.3rem;font-family:var(--mono);font-size:.74rem;min-height:1rem}
.popup-ref-result.ok{color:var(--green)}
.popup-ref-result.err{color:var(--red)}

/* ── Partner referral banner ── */
#partnerBanner {
  display: none;
  position: fixed; top: 0; left: 0; right: 0; z-index: 999;
  background: linear-gradient(90deg, rgba(200,255,0,.12), rgba(124,92,255,.08));
  border-bottom: 1px solid rgba(200,255,0,.25);
  padding: .65rem 1.5rem;
  display: none; align-items: center; justify-content: center; gap: 1rem;
  font-family: 'DM Mono', monospace; font-size: .78rem;
  backdrop-filter: blur(12px);
}
#partnerBanner .banner-text { color: #eeeef5; }
#partnerBanner .banner-text strong { color: #c8ff00; }
#partnerBanner .banner-code {
  background: rgba(200,255,0,.12); border: 1px solid rgba(200,255,0,.3);
  border-radius: 6px; padding: .2rem .65rem;
  color: #c8ff00; letter-spacing: .1em; font-weight: 500; cursor: pointer;
  transition: all .15s;
}
#partnerBanner .banner-code:hover { background: rgba(200,255,0,.22); }
#partnerBanner .banner-close {
  position: absolute; right: 1rem;
  background: none; border: none; color: #3d3d5c;
  cursor: pointer; font-size: 1rem; line-height: 1;
  transition: color .15s; padding: .25rem;
}
#partnerBanner .banner-close:hover { color: #eeeef5; }
body.has-banner { padding-top: 42px; }

</style>
</head>
<body>

<div id="partnerBanner">
  <span class="banner-text" id="bannerText">Pozval ťa <strong id="bannerName"></strong> — zadaj kód pri platbe:</span>
  <span class="banner-code" id="bannerCode" onclick="copyRefCode()" title="Klikni pre kopírovanie"></span>
  <button class="banner-close" onclick="closeBanner()" title="Zavrieť">✕</button>
</div>

<div class="cursor" id="cursor"></div>
<div class="cursor-ring" id="cursorRing"></div>

<!-- PREMIUM POPUP -->
<div class="premium-popup-overlay" id="premiumPopup" onclick="closePremiumPopupOnOverlay(event)">
  <div class="premium-popup">
    <button class="popup-close" onclick="closePremiumPopup()">✕</button>
    <div class="popup-header">
      <div class="popup-eyebrow">Premium prístup</div>
      <h2 class="popup-title">Tréning bez<br><em>obmedzení</em></h2>
      <p class="popup-subtitle">Neobmedzené testy, AI generátor, AI Coach — všetko čo potrebuješ na percentil 85.</p>
    </div>
    <div class="popup-price-block">
      <div class="popup-price"><sup>€</sup>9<span style="font-size:1.2rem">,90</span></div>
      <div class="popup-price-detail"><div class="popup-price-period">/ MESIAC</div><div class="popup-price-cancel">Zruš kedykoľvek</div></div>
    </div>
    <div class="popup-features">
      <div class="popup-feature"><div class="popup-feature-icon">✓</div>Neobmedzené SCIO simulácie s časomieru</div>
      <div class="popup-feature"><div class="popup-feature-icon">✓</div>AI generátor — nové úlohy každý deň</div>
      <div class="popup-feature"><div class="popup-feature-icon">✓</div>AI Coach analýza po každom teste</div>
      <div class="popup-feature"><div class="popup-feature-icon">✓</div>Percentilový tracker + história výsledkov</div>
      <div class="popup-feature"><div class="popup-feature-icon">✓</div>Cielené precvičovanie slabých miest</div>
    </div>
    <div class="popup-email-wrap" id="popupEmailWrap">
      <label class="popup-email-label" for="popupEmailInput">Tvoj email</label>
      <input type="email" id="popupEmailInput" class="popup-email-input" placeholder="meno@gmail.com" autocomplete="email">
    </div>
    <div class="popup-ref-wrap" id="popupRefWrap">
      <span class="popup-ref-label" id="popupRefLabel">Referral kód kamaráta (voliteľné)</span>
      <div class="popup-ref-row">
        <input class="popup-ref-input" id="popupRefInput" maxlength="8" placeholder="Napr. JURAJ2K6" oninput="this.value=this.value.toUpperCase().replace(/[^A-Z0-9]/g,'')" onblur="validateRefOnPopup()">
        <button class="popup-ref-btn" onclick="validateRefOnPopup()" id="popupRefBtn">Overiť</button>
      </div>
      <div class="popup-ref-result" id="popupRefResult"></div>
    </div>
    <div class="popup-error" id="popupError"></div>
    <div class="popup-actions">
      <button class="popup-btn-primary" id="popupMainBtn" onclick="handlePremiumCheckout()">
        <span class="popup-btn-label">Získať Premium →</span>
        <div class="popup-spinner"></div>
      </button>
      <a href="https://sptrener.online/app" class="popup-btn-secondary">Najprv vyskúšať zadarmo →</a>
    </div>
    <div class="popup-trust">
      <div class="popup-trust-item"><span>🔒</span> Platba cez Stripe</div>
      <div class="popup-trust-item"><span>✓</span> Bez záväzku</div>
      <div class="popup-trust-item"><span>✓</span> Okamžitý prístup</div>
    </div>
  </div>
</div>

<!-- NAV -->
<nav id="mainNav">
  <a href="#" class="nav-logo"><div class="nav-dot"></div>VSP TRÉNER</a>
  <div style="display:flex;align-items:center;gap:.75rem;">
    <div class="lang-switcher">
      <button class="lang-btn" id="langSkBtn" onclick="setLanguage('sk')">SK</button>
      <button class="lang-btn" id="langCsBtn" onclick="setLanguage('cs')">CZ</button>
    </div>
    <button class="nav-cta" onclick="openPremiumPopup()">Začať zadarmo →</button>
  </div>
</nav>

<!-- TICKER -->
<div class="ticker-wrap" style="margin-top:70px;">
  <div class="ticker-track" id="tickerTrack">
    <div class="ticker-item">Verbálna časť <span>33 úloh</span></div>
    <div class="ticker-item">Analytická časť <span>33 úloh</span></div>
    <div class="ticker-item">AI generátor <span>nekonečné úlohy</span></div>
    <div class="ticker-item">Cieľ <span>Percentil 85</span></div>
    <div class="ticker-item">Časomiara <span>SCIO simulácia</span></div>
